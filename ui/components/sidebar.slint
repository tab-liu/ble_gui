import { VerticalBox, Button } from "std-widgets.slint";
import { NavItem } from "nav_item.slint";
import { Theme } from "../theme.slint";
import { AppPages } from "../app_pages.slint";

export component Sidebar inherits Rectangle {
    in property <int> current-page;
    in property <bool> device-connected;
    callback navigate(int);
    callback toggle-theme();

    width: 160px;
    background: Theme.bg-sidebar;
    border-width: 1px;
    border-color: Theme.border-subtle;

    VerticalBox {
        padding: 16px;
        spacing: 6px;

        Text {
            text: "功能";
            color: Theme.text-primary;
            font-size: 16px;
            font-weight: 700;
        }

        Rectangle { height: 8px; }

        NavItem {
            label: "主页";
            selected: root.current-page == AppPages.dashboard;
            clicked => { root.navigate(AppPages.dashboard); }
        }
        NavItem {
            label: "Modbus";
            selected: root.current-page == AppPages.modbus;
            clicked => { root.navigate(AppPages.modbus); }
        }
        NavItem {
            label: "设备配置";
            selected: root.current-page == AppPages.device-config;
            clicked => { root.navigate(AppPages.device-config); }
        }
        NavItem {
            label: "外部设备";
            selected: root.current-page == AppPages.external;
            clicked => { root.navigate(AppPages.external); }
        }
        NavItem {
            label: "固件升级";
            selected: root.current-page == AppPages.firmware;
            clicked => { root.navigate(AppPages.firmware); }
        }

        Rectangle { vertical-stretch: 1; }

        Button {
            text: Theme.quick-toggle-label;
            horizontal-stretch: 1;
            clicked => {
                root.toggle-theme();
            }
        }
    }
}
