import { Theme } from "../theme.slint";

export component ToolbarButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 24px;
    min-width: 48px;
    border-radius: 6px;
    opacity: root.enabled ? 1 : 0.45;
    background: root.primary ? Theme.accent : Theme.bg-panel;
    border-width: 1px;
    border-color: root.primary ? Theme.accent : Theme.border;

    TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }

        Text {
            text: root.text;
            color: root.primary ? #ffffff : Theme.text-primary;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
