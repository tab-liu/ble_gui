import { HorizontalBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";

component StatusBarButton inherits Rectangle {
    in property <string> label;
    in property <bool> emphasized: false;
    in property <bool> enabled: true;
    callback clicked();

    min-width: 96px;
    height: 28px;
    border-radius: 6px;
    opacity: root.enabled ? 1 : 0.45;
    background: root.emphasized ? Theme.accent : Theme.bg-panel;
    border-width: 1px;
    border-color: root.emphasized ? Theme.accent : Theme.border;

    TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }

        Text {
            text: root.label;
            color: root.emphasized ? #ffffff : Theme.text-primary;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component BleStatusBar inherits Rectangle {
    in property <bool> connected;
    in property <bool> scanning;
    in property <bool> connecting;
    in property <string> status-text;
    in property <string> device-name;
    in property <string> rssi-text;
    in property <string> action-text;
    callback action-clicked();

    height: 44px;
    background: Theme.bg-statusbar;
    border-width: 1px;
    border-color: Theme.border-subtle;

    HorizontalBox {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 16px;
        alignment: center;

        Text {
            text: "●";
            color: root.connected ? Theme.success : Theme.error;
            font-size: 22px;
            vertical-alignment: center;
        }

        Text {
            text: root.status-text;
            color: Theme.text-primary;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }

        Text {
            text: root.connected ? ("设备: " + root.device-name) : "未连接蓝牙设备";
            color: Theme.text-secondary;
            font-size: 13px;
            vertical-alignment: center;
        }

        Text {
            text: root.connected ? ("信号: " + root.rssi-text) : "";
            color: Theme.text-secondary;
            font-size: 13px;
            vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        StatusBarButton {
            label: root.action-text;
            emphasized: !root.connected && !root.scanning && !root.connecting;
            enabled: true;
            clicked => {
                root.action-clicked();
            }
        }
    }
}
