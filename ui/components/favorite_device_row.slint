import { Theme } from "../theme.slint";

/// 收藏设备行：未扫到时偏暗；扫到时名称点亮；占用时提示。
export component FavoriteDeviceRow inherits Rectangle {
    in property <string> name;
    in property <string> address;
    in property <string> rssi;
    in property <bool> seen;
    in property <bool> occupied;
    in property <bool> selected;
    in property <bool> selectable: true;
    in property <bool> unfavorite-enabled: true;
    callback clicked();
    callback unfavorite-clicked();

    height: 64px;
    border-radius: 8px;
    background: root.selected ? Theme.bg-nav-selected : Theme.bg-panel-alt;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.border-accent : Theme.border;

    // 状态圆点：绿=附近已发现，橙=可能被占用，灰=未发现
    Rectangle {
        x: 12px;
        y: (parent.height - 10px) / 2;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        opacity: root.selectable ? 1 : 0.5;
        background: !root.seen ? Theme.text-dim
            : (root.occupied ? Theme.warning : Theme.success);
    }

    TouchArea {
        x: 0px;
        width: parent.width - 44px;
        height: 100%;
        enabled: root.selectable;
        clicked => {
            if (root.selectable) {
                root.clicked();
            }
        }

        Text {
            x: 28px;
            y: 10px;
            width: parent.width - 40px;
            opacity: root.selectable ? 1 : 0.5;
            text: root.name;
            color: !root.seen ? Theme.text-dim
                : (root.occupied ? Theme.warning : Theme.text-primary);
            font-size: 14px;
            font-weight: root.seen ? 700 : 500;
            horizontal-alignment: left;
            overflow: elide;
        }

        Text {
            x: 28px;
            y: 28px;
            width: parent.width - 40px;
            opacity: root.selectable ? 1 : 0.5;
            text: root.address;
            color: Theme.text-dim;
            font-size: 11px;
            horizontal-alignment: left;
            overflow: elide;
        }

        Text {
            x: 28px;
            y: 44px;
            width: parent.width - 40px;
            opacity: root.selectable ? 1 : 0.5;
            text: !root.seen ? "未在附近发现"
                : (root.occupied ? "附近可见·可能已被占用" : root.rssi);
            color: !root.seen ? Theme.text-dim
                : (root.occupied ? Theme.warning : Theme.success);
            font-size: 11px;
            horizontal-alignment: left;
            overflow: elide;
        }
    }

    TouchArea {
        x: parent.width - 44px;
        y: 8px;
        width: 36px;
        height: 48px;
        enabled: root.unfavorite-enabled;
        clicked => {
            if (root.unfavorite-enabled) {
                root.unfavorite-clicked();
            }
        }

        Text {
            width: 100%;
            height: 100%;
            text: "★";
            color: Theme.accent;
            font-size: 24px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
