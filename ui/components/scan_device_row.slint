import { VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";

export component ScanDeviceRow inherits Rectangle {
    in property <string> name;
    in property <string> address;
    in property <string> rssi;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback clicked();

    height: 52px;
    border-radius: 8px;
    background: root.selected ? Theme.bg-nav-selected : Theme.bg-panel-alt;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.border-accent : Theme.border;
    opacity: root.enabled ? 1 : 0.5;

    TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }

        HorizontalBox {
            padding: 12px;
            spacing: 12px;
            alignment: stretch;

            VerticalBox {
                spacing: 2px;
                horizontal-stretch: 1;

                Text {
                    text: root.name;
                    color: Theme.text-primary;
                    font-size: 14px;
                    font-weight: 600;
                }

                Text {
                    text: root.address;
                    color: Theme.text-dim;
                    font-size: 12px;
                }
            }

            Text {
                text: root.rssi;
                color: Theme.text-secondary;
                font-size: 12px;
                vertical-alignment: center;
            }
        }
    }
}
