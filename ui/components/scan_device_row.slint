import { Theme } from "../theme.slint";

export component ScanDeviceRow inherits Rectangle {
    in property <string> name;
    in property <string> address;
    in property <string> rssi;
    in property <bool> selected;
    in property <bool> favorited;
    in property <bool> enabled: true;
    callback clicked();
    callback favorite-clicked();

    height: 64px;
    border-radius: 8px;
    background: root.selected ? Theme.bg-nav-selected : Theme.bg-panel-alt;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.border-accent : Theme.border;
    opacity: root.enabled ? 1 : 0.5;

    // 实时列表仅展示可连接设备，均为附近已发现
    Rectangle {
        x: 12px;
        y: (parent.height - 10px) / 2;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: Theme.success;
    }

    TouchArea {
        x: 0px;
        width: parent.width - 44px;
        height: 100%;
        enabled: root.enabled;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }

        Text {
            x: 28px;
            y: 10px;
            width: parent.width - 40px;
            text: root.name;
            color: Theme.text-primary;
            font-size: 14px;
            font-weight: 600;
            horizontal-alignment: left;
            overflow: elide;
        }

        Text {
            x: 28px;
            y: 28px;
            width: parent.width - 40px;
            text: root.address;
            color: Theme.text-dim;
            font-size: 11px;
            horizontal-alignment: left;
            overflow: elide;
        }

        Text {
            x: 28px;
            y: 44px;
            width: parent.width - 40px;
            text: root.rssi;
            color: Theme.success;
            font-size: 11px;
            horizontal-alignment: left;
            overflow: elide;
        }
    }

    TouchArea {
        x: parent.width - 44px;
        y: 8px;
        width: 36px;
        height: 48px;
        enabled: root.enabled;
        clicked => {
            if (root.enabled) {
                root.favorite-clicked();
            }
        }

        Text {
            width: 100%;
            height: 100%;
            text: root.favorited ? "★" : "☆";
            color: root.favorited ? Theme.accent : Theme.text-dim;
            font-size: 24px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
