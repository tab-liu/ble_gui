import { Theme } from "../theme.slint";

export component ScanDeviceRow inherits Rectangle {
    in property <string> name;
    in property <string> address;
    in property <string> rssi;
    in property <bool> selected;
    in property <bool> favorited;
    in property <bool> enabled: true;
    callback clicked();
    callback favorite-clicked();

    height: 56px;
    border-radius: 8px;
    background: root.selected ? Theme.bg-nav-selected : Theme.bg-panel-alt;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.border-accent : Theme.border;
    opacity: root.enabled ? 1 : 0.5;

    TouchArea {
        x: 0px;
        width: parent.width - 44px;
        height: 100%;
        enabled: root.enabled;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }

        Text {
            x: 12px;
            y: 11px;
            width: parent.width - 24px;
            text: root.name;
            color: Theme.text-primary;
            font-size: 14px;
            font-weight: 600;
            horizontal-alignment: left;
            overflow: elide;
        }

        Text {
            x: 12px;
            y: 29px;
            width: parent.width - 80px;
            text: root.address;
            color: Theme.text-dim;
            font-size: 12px;
            horizontal-alignment: left;
            overflow: elide;
        }

        Text {
            x: parent.width - 12px - self.preferred-width;
            y: 22px;
            text: root.rssi;
            color: Theme.text-secondary;
            font-size: 12px;
        }
    }

    TouchArea {
        x: parent.width - 40px;
        y: 8px;
        width: 32px;
        height: 40px;
        enabled: root.enabled;
        clicked => {
            if (root.enabled) {
                root.favorite-clicked();
            }
        }

        Text {
            width: 100%;
            height: 100%;
            text: root.favorited ? "★" : "☆";
            color: root.favorited ? Theme.accent : Theme.text-dim;
            font-size: 18px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
