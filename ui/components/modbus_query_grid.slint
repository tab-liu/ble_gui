import { ModbusQueryItem, ModbusQueryLayoutRow } from "../types.slint";
import { Theme } from "../theme.slint";
import { ModbusQueryCard } from "modbus_query_card.slint";
import { ModbusDndApi } from "modbus_dnd.slint";
import { ModbusLayout } from "modbus_layout.slint";

export component ModbusQueryGrid inherits Rectangle {
    in property <[ModbusQueryItem]> items;
    in property <[ModbusQueryLayoutRow]> layout-rows;
    in property <[bool]> query-selection-states;
    callback remove-item(int);
    callback select-item(int, bool);
    callback edit-item(int);
    callback layout-width-changed(length);

    property <length> hover-x: 0;
    property <length> hover-y: 0;
    property <int> drop-slot: 0;
    // 与 src/pages/modbus_query.rs 的 CARD_WIDTH / CARD_HEIGHT / CARD_SPACING 对齐。
    property <int> grid-cols: max(1, floor((root.width / 1px + ModbusLayout.card-spacing / 1px) / (ModbusLayout.stride-x / 1px)));
    property <int> marker-col: mod(root.drop-slot, root.grid-cols);
    property <int> marker-row: root.drop-slot / root.grid-cols;
    property <length> marker-x: root.marker-col == 0 ? 2px : (root.marker-col * ModbusLayout.stride-x - 8px);
    property <length> marker-y: root.marker-row * ModbusLayout.stride-y;
    property <bool> drop-is-noop: ModbusDndApi.dragging-index >= 0
        && (root.drop-slot == ModbusDndApi.dragging-index
            || root.drop-slot == ModbusDndApi.dragging-index + 1);
    property <bool> show-drop-marker: drop-area.current-action != DragAction.none
        && root.items.length > 0
        && !root.drop-is-noop;
    // 与 src/pages/modbus_query.rs 的 CARD_HEIGHT / CARD_SPACING 对齐；底部多留一行空隙，避免最后一行被 ScrollView 裁半。
    property <int> row-count: root.layout-rows.length;
    property <length> content-height: root.items.length == 0 ? 120px
        : root.row-count * ModbusLayout.card-height + max(0, root.row-count - 1) * ModbusLayout.card-spacing + 56px;

    horizontal-stretch: 1;
    vertical-stretch: 0;
    min-width: 0px;
    height: root.content-height;
    clip: true;

    changed width => {
        root.layout-width-changed(self.width);
    }
    init => {
        root.layout-width-changed(self.width);
    }

    drop-area := DropArea {
        width: 100%;
        height: 100%;

        can-drop(event) => {
            root.hover-x = event.position.x;
            root.hover-y = event.position.y;
            root.drop-slot = ModbusDndApi.drop-index(event.position.x, event.position.y, root.width, root.items.length);
            return ModbusDndApi.can-drop(event);
        }
        dropped(event) => {
            ModbusDndApi.dropped(event, event.position.x, event.position.y, root.width);
            return event.proposed-action;
        }

        if root.items.length == 0: Rectangle {
            height: 120px;

            Text {
                text: "暂无 Modbus 查询项";
                color: Theme.text-dim;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        if root.items.length > 0: VerticalLayout {
            spacing: ModbusLayout.card-spacing;
            alignment: start;
            padding-bottom: 56px;
            padding-right: 8px;
            min-width: 0px;

            for row in root.layout-rows: HorizontalLayout {
                spacing: ModbusLayout.card-spacing;
                alignment: start;
                min-width: 0px;

                for idx in row.indices: ModbusQueryCard {
                    name: root.items[idx].name;
                    register: root.items[idx].register;
                    result: root.items[idx].result;
                    result-display: root.items[idx].result-display;
                    result-hex: root.items[idx].result-hex;
                    result-hex-below: root.items[idx].result-hex-below;
                    result-font-size: root.items[idx].result-font-size;
                    source-index: idx;
                    selected: idx < root.query-selection-states.length && root.query-selection-states[idx];
                    remove-clicked => {
                        root.remove-item(idx);
                    }
                    select-clicked(ctrl) => {
                        root.select-item(idx, ctrl);
                    }
                    edit-clicked => {
                        root.edit-item(idx);
                    }
                }
            }
        }

        if root.show-drop-marker: Rectangle {
            x: root.marker-x;
            y: root.marker-y;
            width: 4px;
            height: ModbusLayout.card-height;
            border-radius: 2px;
            background: Theme.accent;
            z: 10;

            Rectangle {
                x: -4px;
                y: -3px;
                width: 12px;
                height: 6px;
                border-radius: 3px;
                background: Theme.accent;
            }

            Rectangle {
                x: -4px;
                y: parent.height - 3px;
                width: 12px;
                height: 6px;
                border-radius: 3px;
                background: Theme.accent;
            }
        }
    }
}
