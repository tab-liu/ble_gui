import {
    Button,
    ComboBox,
    LineEdit,
    ScrollView,
} from "std-widgets.slint";
import { ModbusTab, ModbusQueryLayoutRow, ModbusQueryItem } from "../types.slint";
import { Theme } from "../theme.slint";
import { ModbusTabItem } from "../components/modbus_tab_item.slint";
import { ModbusQueryGrid } from "../components/modbus_query_grid.slint";
import { ToolbarButton } from "../components/toolbar_button.slint";

export component ModbusPage inherits VerticalLayout {
    in property <bool> device-connected;
    in property <[ModbusTab]> modbus-tabs;
    in property <int> active-modbus-tab;
    in property <[ModbusQueryItem]> active-query-items;
    in property <[ModbusQueryLayoutRow]> query-layout-rows;
    in property <bool> has-selected-queries;
    in property <[bool]> query-selection-states;
    in property <bool> show-add-query-form;
    in-out property <string> query-form-name;
    in-out property <string> query-form-register;
    in-out property <int> query-form-value-type-index;
    in-out property <string> query-form-register-count;
    in-out property <string> query-form-scale;
    in-out property <string> active-tab-slave-id;
    in property <int> renaming-tab-index;
    in-out property <string> editing-tab-title;

    property <bool> editing-slave-id: false;

    callback add-tab-request();
    callback remove-tab(int);
    callback switch-tab(int);
    callback start-rename-tab(int);
    callback commit-rename-tab();
    callback commit-tab-slave-id();
    callback show-add-query-panel(int);
    callback confirm-add-query();
    callback cancel-add-query();
    callback remove-query(int, int);
    callback select-query(int, bool);
    callback copy-selected-query();
    callback layout-width-changed(length);

    changed active-modbus-tab => {
        root.editing-slave-id = false;
    }

    spacing: 8px;
    vertical-stretch: 1;

    if !root.device-connected: Text {
        text: "未连接设备：可编辑标签与寄存器；连接后自动轮询";
        color: Theme.text-dim;
        font-size: 12px;
    }

    toolbar-row := HorizontalLayout {
            spacing: 12px;
            cross-axis-alignment: center;

            Text {
                text: "Modbus 查询";
                color: Theme.text-primary;
                font-size: 18px;
                font-weight: 700;
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            HorizontalLayout {
                spacing: 12px;
                cross-axis-alignment: center;

                HorizontalLayout {
                    spacing: 6px;
                    cross-axis-alignment: center;

                    Text {
                        text: "从站号";
                        color: Theme.text-muted;
                        font-size: 13px;
                        vertical-alignment: center;
                    }

                    if !root.editing-slave-id: slave-view := TouchArea {
                        Rectangle {
                            min-width: 36px;
                            height: 22px;
                            border-radius: 4px;
                            background: Theme.bg-panel-alt;
                            border-width: 1px;
                            border-color: slave-view.has-hover ? Theme.border-accent : Theme.border;

                            Text {
                                text: root.active-tab-slave-id == "" ? "0" : root.active-tab-slave-id;
                                color: Theme.text-primary;
                                font-size: 12px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        clicked => {
                            root.editing-slave-id = true;
                        }
                    }

                    if root.editing-slave-id: LineEdit {
                        width: 48px;
                        text <=> root.active-tab-slave-id;
                        placeholder-text: "0";
                        accepted => {
                            root.commit-tab-slave-id();
                            root.editing-slave-id = false;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    cross-axis-alignment: center;

                    ToolbarButton {
                        text: "添加标签";
                        clicked => { root.add-tab-request(); }
                    }

                    if root.modbus-tabs.length > 1: ToolbarButton {
                        text: "删除标签";
                        clicked => { root.remove-tab(root.active-modbus-tab); }
                    }

                    if root.has-selected-queries: ToolbarButton {
                        text: "复制到";
                        clicked => {
                            root.copy-selected-query();
                        }
                    }

                    ToolbarButton {
                        text: root.show-add-query-form ? "取消" : "添加查询";
                        primary: !root.show-add-query-form;
                        clicked => {
                            if (root.show-add-query-form) {
                                root.cancel-add-query();
                            } else {
                                root.show-add-query-panel(root.active-modbus-tab);
                            }
                        }
                    }
                }
            }
        }

        tab-strip := Flickable {
            horizontal-stretch: 1;
            height: 34px;
            viewport-height: 34px;

            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                cross-axis-alignment: center;

                for tab[i] in root.modbus-tabs: ModbusTabItem {
                    title: tab.title;
                    selected: root.active-modbus-tab == i;
                    renaming: root.renaming-tab-index == i;
                    edit-title <=> root.editing-tab-title;
                    switch-tab => { root.switch-tab(i); }
                    request-rename => { root.start-rename-tab(i); }
                    commit-rename => { root.commit-rename-tab(); }
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            border-radius: 10px;
            background: Theme.bg-panel;
            border-width: 1px;
            border-color: Theme.border;

            if root.modbus-tabs.length > 0: VerticalLayout {
                padding: 8px;
                spacing: 8px;

                if root.show-add-query-form: add-query-panel := Rectangle {
                    vertical-stretch: 0;
                    border-radius: 8px;
                    background: Theme.bg-panel-alt;
                    border-width: 1px;
                    border-color: Theme.border-accent;
                    height: add-query-layout.preferred-height;

                    add-query-layout := VerticalLayout {
                        padding: 8px;
                        spacing: 6px;

                        HorizontalLayout {
                            spacing: 6px;
                            cross-axis-alignment: center;

                            Text {
                                text: "名称";
                                color: Theme.text-muted;
                                font-size: 11px;
                                min-width: 28px;
                            }

                            LineEdit {
                                horizontal-stretch: 1;
                                min-width: 80px;
                                text <=> root.query-form-name;
                                placeholder-text: "例如：AC 输入功率";
                            }

                            Text {
                                text: "寄存器";
                                color: Theme.text-muted;
                                font-size: 11px;
                                min-width: 36px;
                            }

                            LineEdit {
                                width: 80px;
                                text <=> root.query-form-register;
                                placeholder-text: "40001";
                            }

                            Text {
                                text: "类型";
                                color: Theme.text-muted;
                                font-size: 11px;
                                min-width: 28px;
                            }

                            ComboBox {
                                width: 100px;
                                model: ["整数", "浮点", "字符串"];
                                current-index <=> root.query-form-value-type-index;
                            }

                            Text {
                                text: "长度";
                                color: Theme.text-muted;
                                font-size: 11px;
                                min-width: 28px;
                            }

                            LineEdit {
                                width: 100px;
                                text <=> root.query-form-register-count;
                                placeholder-text: "1";
                            }

                            Text {
                                text: "倍数";
                                color: Theme.text-muted;
                                font-size: 11px;
                                min-width: 28px;
                            }

                            LineEdit {
                                width: 100px;
                                text <=> root.query-form-scale;
                                placeholder-text: "1";
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: center;

                            Button {
                                text: "取消";
                                clicked => { root.cancel-add-query(); }
                            }

                            Button {
                                text: "添加";
                                primary: true;
                                clicked => { root.confirm-add-query(); }
                            }
                        }
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    horizontal-stretch: 1;

                    ModbusQueryGrid {
                        items: root.active-query-items;
                        layout-rows: root.query-layout-rows;
                        query-selection-states: root.query-selection-states;
                        remove-item(index) => {
                            root.remove-query(root.active-modbus-tab, index);
                        }
                        select-item(index, ctrl) => {
                            root.select-query(index, ctrl);
                        }
                        layout-width-changed(width) => {
                            root.layout-width-changed(width);
                        }
                    }
                }
            }
        }
}

