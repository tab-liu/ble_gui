import { Button, VerticalBox, HorizontalBox, LineEdit, ScrollView } from "std-widgets.slint";
import { ModbusTab } from "../types.slint";
import { Theme } from "../theme.slint";
import { ModbusTabItem } from "../components/modbus_tab_item.slint";
import { ModbusQueryRow } from "../components/modbus_query_row.slint";

export component ModbusPage inherits VerticalBox {
    in property <bool> device-connected;
    in property <[ModbusTab]> modbus-tabs;
    in property <int> active-modbus-tab;
    in property <bool> show-add-query-form;
    in-out property <string> query-form-name;
    in-out property <string> query-form-slave-id;
    in-out property <string> query-form-register;
    in property <int> renaming-tab-index;
    in-out property <string> editing-tab-title;

    callback add-tab-request();
    callback remove-tab(int);
    callback switch-tab(int);
    callback start-rename-tab(int);
    callback commit-rename-tab();
    callback show-add-query-panel(int);
    callback confirm-add-query();
    callback cancel-add-query();
    callback remove-query(int, int);

    spacing: 8px;
    vertical-stretch: 1;

    if root.device-connected: VerticalBox {
        spacing: 8px;
        vertical-stretch: 1;

        HorizontalBox {
            alignment: space-between;

            Text {
                text: "Modbus 查询";
                color: Theme.text-primary;
                font-size: 18px;
                font-weight: 700;
            }

            HorizontalBox {
                spacing: 8px;

                Button {
                    text: "+ 新标签";
                    clicked => { root.add-tab-request(); }
                }

                if root.modbus-tabs.length > 1: Button {
                    text: "删除标签";
                    clicked => { root.remove-tab(root.active-modbus-tab); }
                }
            }
        }

        HorizontalBox {
            spacing: 8px;
            alignment: start;

            for tab[i] in root.modbus-tabs: ModbusTabItem {
                title: tab.title;
                selected: root.active-modbus-tab == i;
                renaming: root.renaming-tab-index == i;
                edit-title <=> root.editing-tab-title;
                switch-tab => { root.switch-tab(i); }
                request-rename => { root.start-rename-tab(i); }
                commit-rename => { root.commit-rename-tab(); }
            }
        }

        Text {
            text: "提示：单击切换标签，双击标签文字可重命名";
            color: Theme.text-dim;
            font-size: 11px;
        }

        Rectangle {
            vertical-stretch: 1;
            border-radius: 10px;
            background: Theme.bg-panel;
            border-width: 1px;
            border-color: Theme.border;

            if root.modbus-tabs.length > 0: VerticalBox {
                padding: 12px;
                spacing: 8px;

                HorizontalBox {
                    alignment: space-between;

                    Text {
                        text: "寄存器列表 · " + root.modbus-tabs[root.active-modbus-tab].title;
                        color: Theme.text-primary;
                        font-size: 14px;
                        font-weight: 600;
                    }

                    Button {
                        text: root.show-add-query-form ? "取消添加" : "+ 添加查询";
                        primary: !root.show-add-query-form;
                        clicked => {
                            if (root.show-add-query-form) {
                                root.cancel-add-query();
                            } else {
                                root.show-add-query-panel(root.active-modbus-tab);
                            }
                        }
                    }
                }

                if root.show-add-query-form: Rectangle {
                    border-radius: 8px;
                    background: Theme.bg-panel-alt;
                    border-width: 1px;
                    border-color: Theme.border-accent;

                    VerticalBox {
                        padding: 12px;
                        spacing: 8px;

                        Text {
                            text: "添加 Modbus 查询";
                            color: Theme.text-primary;
                            font-size: 13px;
                            font-weight: 600;
                        }

                        HorizontalBox {
                            spacing: 8px;

                            VerticalBox {
                                spacing: 4px;
                                horizontal-stretch: 1;

                                Text {
                                    text: "名称";
                                    color: Theme.text-muted;
                                    font-size: 11px;
                                }

                                LineEdit {
                                    text <=> root.query-form-name;
                                    placeholder-text: "例如：室内温度";
                                }
                            }

                            VerticalBox {
                                spacing: 4px;
                                min-width: 80px;

                                Text {
                                    text: "从站号";
                                    color: Theme.text-muted;
                                    font-size: 11px;
                                }

                                LineEdit {
                                    text <=> root.query-form-slave-id;
                                    placeholder-text: "1";
                                }
                            }

                            VerticalBox {
                                spacing: 4px;
                                min-width: 100px;

                                Text {
                                    text: "寄存器";
                                    color: Theme.text-muted;
                                    font-size: 11px;
                                }

                                LineEdit {
                                    text <=> root.query-form-register;
                                    placeholder-text: "40001";
                                }
                            }
                        }

                        HorizontalBox {
                            spacing: 8px;
                            alignment: end;

                            Button {
                                text: "取消";
                                clicked => { root.cancel-add-query(); }
                            }

                            Button {
                                text: "添加";
                                primary: true;
                                clicked => { root.confirm-add-query(); }
                            }
                        }
                    }
                }

                ScrollView {
                    vertical-stretch: 1;

                    VerticalBox {
                        spacing: 8px;

                        for item[j] in root.modbus-tabs[root.active-modbus-tab].items: ModbusQueryRow {
                            name: item.name;
                            slave-id: item.slave-id;
                            register: item.register;
                            status: item.status;
                            result: item.result;
                            remove-clicked => {
                                root.remove-query(root.active-modbus-tab, j);
                            }
                        }

                        if root.modbus-tabs[root.active-modbus-tab].items.length == 0: Rectangle {
                            height: 120px;
                            Text {
                                text: "暂无 Modbus 查询项";
                                color: Theme.text-dim;
                                font-size: 13px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }

    if !root.device-connected: VerticalBox {
        vertical-stretch: 1;
        Text {
            text: "请先连接蓝牙设备";
            color: Theme.text-dim;
            font-size: 14px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
