import { VerticalBox, HorizontalBox, ScrollView, LineEdit, CheckBox, Button } from "std-widgets.slint";
import { BleScanDevice, BleFavoriteDevice } from "../types.slint";
import { Theme } from "../theme.slint";
import { ScanDeviceRow } from "../components/scan_device_row.slint";
import { FavoriteDeviceRow } from "../components/favorite_device_row.slint";
import { SocCard } from "../components/soc_card.slint";
import { PowerMetricCard } from "../components/power_metric_card.slint";
import { OutputControlRow } from "../components/output_control_row.slint";

export component DashboardPage inherits VerticalBox {
    in property <bool> device-connected;
    in property <bool> scanning;
    in property <bool> ble-connecting;
    in property <[BleScanDevice]> scan-devices;
    in property <[BleFavoriteDevice]> favorite-devices;
    in property <int> scan-device-total;
    in property <string> scan-empty-message;
    in property <int> dashboard-soc: -1;
    in property <int> dashboard-ac-output-w: -1;
    in property <int> dashboard-dc-output-w: -1;
    in property <int> dashboard-pv-input-w: -1;
    in property <int> dashboard-ac-input-w: -1;
    in property <bool> dashboard-data-valid;
    in property <bool> ac-output-on;
    in property <bool> dc-output-on;
    in property <bool> output-control-busy;
    in-out property <string> scan-filter;
    in-out property <bool> scan-rssi-filter-enabled;
    in-out property <string> scan-rssi-min;
    in-out property <string> selected-scan-address: "";
    callback select-scan-device(string);
    callback connect-selected-clicked();
    callback toggle-favorite-clicked(string);
    callback scan-filters-changed();
    callback ac-output-toggle();
    callback dc-output-toggle();

    spacing: 16px;
    vertical-stretch: 1;

    if !root.device-connected: VerticalBox {
        spacing: 12px;
        vertical-stretch: 1;

        Text {
            text: "连接蓝牙设备";
            color: Theme.text-primary;
            font-size: 18px;
            font-weight: 700;
        }

        LineEdit {
            text <=> root.scan-filter;
            placeholder-text: "按名称过滤扫描列表（不区分大小写）";
            enabled: !root.ble-connecting;
            edited => {
                root.scan-filters-changed();
            }
        }

        HorizontalBox {
            spacing: 12px;
            alignment: start;

            CheckBox {
                text: "按信号强度过滤";
                checked <=> root.scan-rssi-filter-enabled;
                enabled: !root.ble-connecting;
                toggled => {
                    root.scan-filters-changed();
                }
            }

            LineEdit {
                width: 100px;
                enabled: root.scan-rssi-filter-enabled && !root.ble-connecting;
                text <=> root.scan-rssi-min;
                placeholder-text: "-70";
                edited => {
                    root.scan-filters-changed();
                }
            }

            Text {
                text: "dBm 及以上";
                color: root.scan-rssi-filter-enabled ? Theme.text-secondary : Theme.text-dim;
                font-size: 13px;
                vertical-alignment: center;
            }
        }

        HorizontalBox {
            spacing: 12px;
            alignment: start;

            Button {
                text: root.ble-connecting ? "连接中…" : "连接所选设备";
                primary: true;
                min-width: 120px;
                enabled: !root.ble-connecting && root.selected-scan-address != "";
                clicked => {
                    root.connect-selected-clicked();
                }
            }

            Text {
                text: root.ble-connecting
                    ? "正在连接/查找，可点顶部「取消」终止"
                    : (root.selected-scan-address != ""
                        ? ("已选: " + root.selected-scan-address)
                        : "选中设备后点「连接所选设备」；右侧扫描结果点 ★ 收藏");
                color: Theme.text-secondary;
                font-size: 13px;
                vertical-alignment: center;
            }
        }

        GridLayout {
            spacing: 12px;
            padding: 0px;
            vertical-stretch: 1;

            // 左：收藏
            Rectangle {
                row: 0;
                col: 0;
                min-width: 0px;
                preferred-width: 0px;
                horizontal-stretch: 1;
                border-radius: 10px;
                background: Theme.bg-panel;
                border-width: 1px;
                border-color: Theme.border;

                VerticalBox {
                    padding: 10px;
                    spacing: 8px;

                    Text {
                        text: "收藏";
                        color: Theme.text-primary;
                        font-size: 14px;
                        font-weight: 700;
                    }

                    Text {
                        text: "● 绿=附近已发现  ● 灰=未发现  ● 橙=可能被占用";
                        color: Theme.text-dim;
                        font-size: 11px;
                        overflow: elide;
                    }

                    ScrollView {
                        vertical-stretch: 1;

                        VerticalBox {
                            spacing: 8px;

                            for fav in root.favorite-devices: FavoriteDeviceRow {
                                name: fav.name;
                                address: fav.address;
                                rssi: fav.rssi;
                                seen: fav.seen;
                                occupied: fav.occupied;
                                selected: fav.address == root.selected-scan-address;
                                selectable: !root.ble-connecting && fav.selectable;
                                unfavorite-enabled: !root.ble-connecting;
                                clicked => {
                                    root.select-scan-device(fav.address);
                                }
                                unfavorite-clicked => {
                                    root.toggle-favorite-clicked(fav.address);
                                }
                            }

                            if root.favorite-devices.length == 0: Rectangle {
                                height: 100px;
                                Text {
                                    text: "暂无收藏\n在右侧扫描结果点 ★ 添加";
                                    color: Theme.text-dim;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // 右：实时扫描
            Rectangle {
                row: 0;
                col: 1;
                min-width: 0px;
                preferred-width: 0px;
                horizontal-stretch: 1;
                border-radius: 10px;
                background: Theme.bg-panel;
                border-width: 1px;
                border-color: Theme.border;

                VerticalBox {
                    padding: 10px;
                    spacing: 8px;

                    Text {
                        text: "扫描结果";
                        color: Theme.text-primary;
                        font-size: 14px;
                        font-weight: 700;
                    }

                    Text {
                        text: "未收藏的附近设备";
                        color: Theme.text-dim;
                        font-size: 11px;
                        overflow: elide;
                    }

                    ScrollView {
                        vertical-stretch: 1;

                        VerticalBox {
                            spacing: 8px;

                            for dev in root.scan-devices: ScanDeviceRow {
                                name: dev.name;
                                address: dev.address;
                                rssi: dev.rssi;
                                selected: dev.address == root.selected-scan-address;
                                favorited: false;
                                enabled: !root.ble-connecting;
                                clicked => {
                                    root.select-scan-device(dev.address);
                                }
                                favorite-clicked => {
                                    root.toggle-favorite-clicked(dev.address);
                                }
                            }

                            if root.scan-device-total == 0: Rectangle {
                                height: 100px;
                                Text {
                                    text: root.scan-empty-message;
                                    color: Theme.text-dim;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.device-connected: VerticalBox {
        spacing: 16px;
        vertical-stretch: 1;
        alignment: start;

        Rectangle {
            vertical-stretch: 0;
            border-radius: 12px;
            background: Theme.bg-panel;
            border-width: 1px;
            border-color: Theme.border;

            VerticalBox {
                padding: 16px;
                spacing: 12px;

                HorizontalBox {
                    spacing: 16px;
                    alignment: start;

                    SocCard {
                        soc: root.dashboard-soc;
                        data-valid: root.dashboard-data-valid;
                    }

                    VerticalBox {
                        spacing: 12px;

                        HorizontalBox {
                            spacing: 12px;
                            alignment: start;

                            PowerMetricCard {
                                label: "AC 输出功率";
                                power-w: root.dashboard-ac-output-w;
                                data-valid: root.dashboard-data-valid;
                                value-color: Theme.accent;
                            }

                            PowerMetricCard {
                                label: "DC 输出功率";
                                power-w: root.dashboard-dc-output-w;
                                data-valid: root.dashboard-data-valid;
                                value-color: #f59e0b;
                            }
                        }

                        HorizontalBox {
                            spacing: 12px;
                            alignment: start;

                            PowerMetricCard {
                                label: "PV 输入功率";
                                power-w: root.dashboard-pv-input-w;
                                data-valid: root.dashboard-data-valid;
                                value-color: Theme.success;
                            }

                            PowerMetricCard {
                                label: "AC 输入功率";
                                power-w: root.dashboard-ac-input-w;
                                data-valid: root.dashboard-data-valid;
                                value-color: Theme.text-primary;
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            vertical-stretch: 0;
            horizontal-stretch: 1;
            border-radius: 12px;
            background: Theme.bg-panel-alt;
            border-width: 1px;
            border-color: Theme.border;

            VerticalBox {
                padding: 16px;
                spacing: 12px;

                Text {
                    text: "输出控制";
                    color: Theme.text-primary;
                    font-size: 14px;
                    font-weight: 600;
                }

                HorizontalBox {
                    spacing: 12px;
                    cross-axis-alignment: start;

                    OutputControlRow {
                        label: "AC 输出";
                        output-on: root.ac-output-on;
                        data-valid: root.dashboard-data-valid;
                        busy: root.output-control-busy;
                        toggle-clicked => {
                            root.ac-output-toggle();
                        }
                    }

                    OutputControlRow {
                        label: "DC 输出";
                        output-on: root.dc-output-on;
                        data-valid: root.dashboard-data-valid;
                        busy: root.output-control-busy;
                        toggle-clicked => {
                            root.dc-output-toggle();
                        }
                    }
                }
            }
        }
    }
}
