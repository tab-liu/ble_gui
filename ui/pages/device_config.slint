import {
    Button,
    ComboBox,
    LineEdit,
    ScrollView,
} from "std-widgets.slint";
import {
    DeviceConfigGroup,
    DeviceConfigItem,
    BuiltinConfigItem,
} from "../types.slint";
import { Theme } from "../theme.slint";
import { ModbusTabItem } from "../components/modbus_tab_item.slint";
import { ToolbarButton } from "../components/toolbar_button.slint";
import { DeviceConfigRow } from "../components/device_config_row.slint";
import { BuiltinConfigRow } from "../components/builtin_config_row.slint";

/// 设备配置：固定「常用」+ 可增删灵活分组。
export component DeviceConfigPage inherits VerticalLayout {
    in property <bool> device-connected;
    in property <[DeviceConfigGroup]> config-groups;
    in property <int> active-config-group;
    in property <[DeviceConfigItem]> active-config-items;
    in property <[BuiltinConfigItem]> builtin-config-items;
    in-out property <string> active-group-slave-id;
    in property <int> renaming-group-index;
    in-out property <string> editing-group-title;
    in property <bool> show-add-config-form;
    in-out property <string> config-form-name;
    in-out property <string> config-form-register;
    in-out property <int> config-form-widget-index;
    in-out property <int> config-form-value-type-index;
    in-out property <string> config-form-register-count;

    property <bool> editing-slave-id: false;
    property <bool> on-builtin: root.config-groups.length > 0
        && root.active-config-group >= 0
        && root.active-config-group < root.config-groups.length
        && root.config-groups[root.active-config-group].builtin;

    callback add-group-request();
    callback remove-group(int);
    callback switch-group(int);
    callback start-rename-group(int);
    callback commit-rename-group();
    callback commit-group-slave-id();
    callback show-add-config-panel();
    callback confirm-add-config();
    callback cancel-add-config();
    callback config-value-edited(int, string);
    callback write-config-item(int);
    callback remove-config-item(int);
    callback builtin-value-edited(int, string);
    callback write-builtin-item(int);

    changed active-config-group => {
        root.editing-slave-id = false;
    }

    spacing: 8px;
    vertical-stretch: 1;

    HorizontalLayout {
        spacing: 12px;
        cross-axis-alignment: center;

        Text {
            text: "设备配置";
            color: Theme.text-primary;
            font-size: 18px;
            font-weight: 700;
        }

        Rectangle { horizontal-stretch: 1; }

        // 从站号：常用页只读显示
        HorizontalLayout {
            spacing: 6px;
            cross-axis-alignment: center;

            Text {
                text: "从站号";
                color: Theme.text-muted;
                font-size: 13px;
                vertical-alignment: center;
            }

            if root.on-builtin || !root.editing-slave-id: slave-view := TouchArea {
                enabled: !root.on-builtin;
                Rectangle {
                    min-width: 36px;
                    height: 22px;
                    border-radius: 4px;
                    background: Theme.bg-panel-alt;
                    border-width: 1px;
                    border-color: !root.on-builtin && slave-view.has-hover ? Theme.border-accent : Theme.border;

                    Text {
                        text: root.active-group-slave-id == "" ? "0" : root.active-group-slave-id;
                        color: Theme.text-primary;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                clicked => {
                    if (!root.on-builtin) {
                        root.editing-slave-id = true;
                    }
                }
            }

            if !root.on-builtin && root.editing-slave-id: LineEdit {
                width: 48px;
                text <=> root.active-group-slave-id;
                accepted => {
                    root.commit-group-slave-id();
                    root.editing-slave-id = false;
                }
                edited => { }
            }
        }

        if !root.on-builtin: ToolbarButton {
            text: root.show-add-config-form ? "取消添加" : "+ 配置项";
            primary: !root.show-add-config-form;
            clicked => {
                if (root.show-add-config-form) {
                    root.cancel-add-config();
                } else {
                    root.show-add-config-panel();
                }
            }
        }

        ToolbarButton {
            text: "+ 分组";
            clicked => { root.add-group-request(); }
        }

        if !root.on-builtin: ToolbarButton {
            text: "删除本组";
            clicked => { root.remove-group(root.active-config-group); }
        }
    }

    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        cross-axis-alignment: center;

        for group[index] in root.config-groups: ModbusTabItem {
            title: group.title;
            selected: index == root.active-config-group;
            renaming: index == root.renaming-group-index;
            renameable: !group.builtin;
            edit-title <=> root.editing-group-title;
            switch-tab => { root.switch-group(index); }
            request-rename => { root.start-rename-group(index); }
            commit-rename => { root.commit-rename-group(); }
        }
    }

    if !root.on-builtin && root.show-add-config-form: add-config-panel := Rectangle {
        vertical-stretch: 0;
        border-radius: 8px;
        background: Theme.bg-panel-alt;
        border-width: 1px;
        border-color: Theme.border-accent;
        height: add-config-layout.preferred-height;

        add-config-layout := VerticalLayout {
            padding: 8px;
            spacing: 6px;

            HorizontalLayout {
                spacing: 6px;
                cross-axis-alignment: center;

                Text {
                    text: "名称";
                    color: Theme.text-muted;
                    font-size: 11px;
                    min-width: 28px;
                }
                LineEdit {
                    horizontal-stretch: 1;
                    min-width: 80px;
                    text <=> root.config-form-name;
                    placeholder-text: "如 WiFi 名称";
                }

                Text {
                    text: "寄存器";
                    color: Theme.text-muted;
                    font-size: 11px;
                    min-width: 36px;
                }
                LineEdit {
                    width: 100px;
                    text <=> root.config-form-register;
                    placeholder-text: "40001";
                }

                Text {
                    text: "控件";
                    color: Theme.text-muted;
                    font-size: 11px;
                    min-width: 28px;
                }
                ComboBox {
                    width: 100px;
                    model: ["文本", "数值"];
                    current-index <=> root.config-form-widget-index;
                }

                Text {
                    text: "解析";
                    color: Theme.text-muted;
                    font-size: 11px;
                    min-width: 28px;
                }
                ComboBox {
                    width: 100px;
                    model: ["整数", "浮点", "字符串"];
                    current-index <=> root.config-form-value-type-index;
                }

                Text {
                    text: "长度";
                    color: Theme.text-muted;
                    font-size: 11px;
                    min-width: 28px;
                }
                LineEdit {
                    width: 100px;
                    text <=> root.config-form-register-count;
                    placeholder-text: "1";
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: center;

                Button {
                    text: "取消";
                    clicked => { root.cancel-add-config(); }
                }

                Button {
                    text: "添加";
                    primary: true;
                    clicked => { root.confirm-add-config(); }
                }
            }
        }
    }

    ScrollView {
        vertical-stretch: 1;

        VerticalLayout {
            spacing: 8px;
            padding-right: 4px;

            if root.on-builtin: VerticalLayout {
                spacing: 8px;

                for item[index] in root.builtin-config-items: BuiltinConfigRow {
                    name: item.name;
                    register: item.register;
                    value-type: item.value-type;
                    register-count: item.register-count;
                    widget-kind: item.widget-kind;
                                enum-labels: item.enum-labels;
                                enum-values: item.enum-values;
                                enum-index: item.enum-index;
                                result-display: item.result-display;
                    write-value: item.write-value;
                    status: item.status;
                    dirty: item.dirty;
                    write-enabled: item.write-enabled;
                    disabled-hint: item.disabled-hint;
                    write-value-edited(v) => { root.builtin-value-edited(index, v); }
                    write-clicked => { root.write-builtin-item(index); }
                }

                if root.builtin-config-items.length == 0: Rectangle {
                    height: 80px;
                    Text {
                        text: "常用设置映射尚未配置";
                        color: Theme.text-dim;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            if !root.on-builtin: VerticalLayout {
                spacing: 8px;

                for item[index] in root.active-config-items: DeviceConfigRow {
                    name: item.name;
                    register: item.register;
                    value-type: item.value-type;
                    register-count: item.register-count;
                    widget-kind: item.widget-kind;
                    result-display: item.result-display;
                    result-font-size: item.result-font-size;
                    write-value: item.write-value;
                    status: item.status;
                    dirty: item.dirty;
                    write-enabled: root.device-connected;
                    write-value-edited(v) => { root.config-value-edited(index, v); }
                    write-clicked => { root.write-config-item(index); }
                    remove-clicked => { root.remove-config-item(index); }
                }

                if root.active-config-items.length == 0: Rectangle {
                    height: 80px;
                    Text {
                        text: "本组暂无配置项 · 点「+ 配置项」添加";
                        color: Theme.text-dim;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
