import { VerticalBox, LineEdit } from "std-widgets.slint";
import { Theme } from "../theme.slint";

component FwActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();

    min-width: 96px;
    height: 36px;
    border-radius: 8px;
    opacity: root.enabled ? 1.0 : 0.45;
    background: root.danger ? (root.enabled ? Theme.error : Theme.bg-panel-alt)
        : root.primary ? (root.enabled ? Theme.accent : Theme.bg-panel-alt)
        : Theme.bg-panel-alt;
    border-width: 1px;
    border-color: root.danger ? Theme.error
        : root.primary ? Theme.accent
        : Theme.border;

    TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        clicked => { root.clicked(); }

        Text {
            text: root.text;
            color: (root.primary || root.danger) && root.enabled ? #ffffff : Theme.text-primary;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component FwInfoRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: Theme.text-primary;

    spacing: 8px;
    min-height: 26px;

    Text {
        text: root.label;
        color: Theme.text-muted;
        font-size: 12px;
        width: 72px;
        vertical-alignment: top;
    }
    Text {
        text: root.value;
        color: root.value-color;
        font-size: 12px;
        vertical-alignment: top;
        wrap: word-wrap;
        horizontal-stretch: 1;
    }
}

component FwCard inherits Rectangle {
    border-radius: 10px;
    background: Theme.bg-panel;
    border-width: 1px;
    border-color: Theme.border;
}

export component FirmwarePage inherits VerticalBox {
    in property <bool> device-connected;
    in property <string> device-name;
    in property <string> firmware-status-text;
    in property <string> firmware-current-version;
    in property <string> firmware-device-type;
    in property <string> firmware-device-sn;
    in property <string> firmware-file-name;
    in property <string> firmware-file-size;
    in property <string> firmware-md5;
    in property <string> firmware-type-text;
    in property <string> firmware-image-version;
    in-out property <string> firmware-ota-version;
    in property <string> firmware-dev-model;
    in property <bool> firmware-has-file;
    in property <bool> firmware-part-mismatch;
    in property <int> firmware-phase;
    in property <int> firmware-progress;
    in property <string> firmware-stage-text;
    in property <string> firmware-result-text;
    in property <string> firmware-fail-reason;
    in property <bool> firmware-can-start;
    in property <bool> firmware-can-stop;

    callback pick-file();
    callback clear-file();
    callback start-upgrade();
    callback stop-upgrade();
    callback ota-version-edited(string);

    property <color> result-color: root.firmware-phase == 3 ? Theme.success
        : (root.firmware-phase == 4 ? Theme.error
            : (root.firmware-phase == 2 ? Theme.accent : Theme.text-secondary));
    property <color> bar-color: root.firmware-phase == 3 ? Theme.success
        : (root.firmware-phase == 4 ? Theme.error : Theme.accent);

    spacing: 12px;
    vertical-stretch: 1;

    HorizontalLayout {
        spacing: 12px;
        height: 28px;

        Text {
            text: "固件升级";
            color: Theme.text-primary;
            font-size: 18px;
            font-weight: 700;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        Text {
            text: root.device-connected ? ("已连接  " + root.device-name) : "未连接";
            color: root.device-connected ? Theme.success : Theme.text-dim;
            font-size: 12px;
            vertical-alignment: center;
        }
    }

    // 剩余高度按 5:8 分（约黄金比 0.38 / 0.62）：上排准备区，下排进度主操作。
        VerticalLayout {
        vertical-stretch: 1;
        spacing: 12px;

        FwCard {
            width: 100%;
            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 6px;

                Text {
                    text: "当前设备";
                    color: Theme.text-primary;
                    font-size: 13px;
                    font-weight: 600;
                    height: 18px;
                }
                HorizontalLayout {
                    spacing: 16px;
                    FwInfoRow {
                        label: "机型";
                        value: root.device-connected ? root.firmware-device-type : "未连接";
                    }
                    FwInfoRow {
                        label: "SN";
                        value: root.device-connected ? root.firmware-device-sn : "—";
                    }
                }
                FwInfoRow {
                    label: "软件版本";
                    value: root.device-connected ? root.firmware-current-version : "—";
                }
            }
        }

        HorizontalLayout {
            width: 100%;
            spacing: 12px;
            vertical-stretch: 5;
            min-height: 220px;

            FwCard {
                min-width: 0px;
                preferred-width: 0px;
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    alignment: start;

                    Text {
                        text: "选择固件";
                        color: Theme.text-primary;
                        font-size: 14px;
                        font-weight: 600;
                        height: 20px;
                    }

                    Rectangle {
                        height: 44px;
                        border-radius: 8px;
                        background: Theme.bg-panel-alt;
                        border-width: 1px;
                        border-color: Theme.border;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 8px;

                            Text {
                                text: root.firmware-has-file ? root.firmware-file-name : "尚未选择文件";
                                color: root.firmware-has-file ? Theme.text-primary : Theme.text-dim;
                                font-size: 13px;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: root.firmware-has-file ? root.firmware-file-size : "";
                                color: Theme.text-muted;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        height: 36px;

                        FwActionButton {
                            text: "选择文件";
                            primary: true;
                            enabled: root.firmware-phase != 2;
                            clicked => { root.pick-file(); }
                        }
                        FwActionButton {
                            text: "清除";
                            enabled: root.firmware-has-file && root.firmware-phase != 2;
                            clicked => { root.clear-file(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        min-height: 32px;

                        Text {
                            text: "料号版本";
                            color: Theme.text-muted;
                            font-size: 12px;
                            width: 72px;
                            vertical-alignment: center;
                        }
                        LineEdit {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            text <=> root.firmware-ota-version;
                            enabled: root.firmware-has-file && root.firmware-phase != 2;
                            edited => { root.ota-version-edited(self.text); }
                        }
                    }

                    if root.firmware-part-mismatch || root.firmware-phase == 4: Text {
                        min-height: 18px;
                        text: root.firmware-status-text;
                        color: root.firmware-phase == 4 ? Theme.error : Theme.warning;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }

            FwCard {
                min-width: 0px;
                preferred-width: 0px;
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: 16px;
                    spacing: 4px;
                    alignment: start;

                    Text {
                        text: "固件信息";
                        color: Theme.text-primary;
                        font-size: 14px;
                        font-weight: 600;
                        height: 20px;
                    }

                    FwInfoRow { label: "类型"; value: root.firmware-type-text; }
                    FwInfoRow { label: "文件版本"; value: root.firmware-image-version; }
                    FwInfoRow { label: "项目代号"; value: root.firmware-dev-model; }
                    FwInfoRow { label: "MD5"; value: root.firmware-md5; }
                }
            }
        }

        FwCard {
            width: 100%;
            vertical-stretch: 8;
            min-height: 200px;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 12px;
                    height: 22px;

                    Text {
                        text: "升级进度";
                        color: Theme.text-primary;
                        font-size: 14px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.firmware-stage-text;
                        color: Theme.text-secondary;
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    min-height: 72px;
                    border-radius: 10px;
                    clip: true;
                    background: Theme.bg-panel-alt;
                    border-width: 1px;
                    border-color: Theme.border;

                    Rectangle {
                        x: 0px;
                        y: 0px;
                        height: 100%;
                        width: parent.width * root.firmware-progress / 100;
                        background: root.bar-color;
                    }

                    Text {
                        width: 100%;
                        height: 100%;
                        text: root.firmware-progress + "%";
                        color: root.firmware-progress >= 50 ? #ffffff : root.bar-color;
                        font-size: 32px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    height: 36px;

                    FwActionButton {
                        text: "开始升级";
                        primary: true;
                        enabled: root.firmware-can-start;
                        clicked => { root.start-upgrade(); }
                    }
                    FwActionButton {
                        text: "停止";
                        danger: true;
                        enabled: root.firmware-can-stop;
                        clicked => { root.stop-upgrade(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }

                if root.firmware-phase == 3 || root.firmware-phase == 4: HorizontalLayout {
                    spacing: 24px;
                    FwInfoRow {
                        label: "结果";
                        value: root.firmware-result-text;
                        value-color: root.result-color;
                    }
                    if root.firmware-phase == 4 && root.firmware-fail-reason != "": FwInfoRow {
                        label: "失败原因";
                        value: root.firmware-fail-reason;
                        value-color: Theme.error;
                    }
                }
            }
        }
    }
}
