import { VerticalBox, HorizontalBox, Palette } from "std-widgets.slint";

import {
    ModbusQueryItem,
    ModbusTab,
    ModbusQueryLayoutRow,
    BleScanDevice,
    BleFavoriteDevice,
    DeviceConfigItem,
    DeviceConfigGroup,
    BuiltinConfigItem,
} from "types.slint";

import { Theme } from "theme.slint";
import { BleStatusBar } from "components/ble_status_bar.slint";
import { Sidebar } from "components/sidebar.slint";
import { NewTabDialog } from "components/new_tab_dialog.slint";
import { DashboardPage } from "pages/dashboard.slint";
import { ModbusPage } from "pages/modbus.slint";
import { DeviceConfigPage } from "pages/device_config.slint";
import { SettingsPage } from "pages/settings.slint";
import { FirmwarePage } from "pages/firmware.slint";
import { ModbusDndApi } from "components/modbus_dnd.slint";

export {
    ModbusQueryItem,
    ModbusTab,
    ModbusQueryLayoutRow,
    BleScanDevice,
    BleFavoriteDevice,
    DeviceConfigItem,
    DeviceConfigGroup,
    BuiltinConfigItem,
    Theme,
    Palette,
    ModbusDndApi,
}

// dialog-kind: 0=关闭, 1=新建标签
export component MainWindow inherits Window {
    in-out property <bool> device-connected;
    in-out property <string> ble-status-text;
    in-out property <string> ble-device-name;
    in-out property <string> ble-rssi-text;
    in-out property <string> ble-action-text;
    in-out property <[BleScanDevice]> scan-devices;
    in-out property <[BleFavoriteDevice]> favorite-devices;
    in-out property <int> scan-device-total;
    in-out property <bool> scanning;
    in-out property <bool> ble-connecting;
    in-out property <string> scan-empty-message: "";
    in-out property <string> selected-scan-address: "";
    in-out property <string> ble-scan-filter: "";
    in-out property <bool> ble-scan-rssi-filter-enabled: false;
    in-out property <string> ble-scan-rssi-min: "-70";

    in-out property <int> dashboard-soc: -1;
    in-out property <int> dashboard-ac-output-w: -1;
    in-out property <int> dashboard-dc-output-w: -1;
    in-out property <int> dashboard-pv-input-w: -1;
    in-out property <int> dashboard-ac-input-w: -1;
    in-out property <bool> dashboard-data-valid;
    in-out property <bool> ac-output-on;
    in-out property <bool> dc-output-on;
    in-out property <bool> output-control-busy;

    in-out property <[ModbusTab]> modbus-tabs;
    in-out property <int> active-modbus-tab: 0;
    in-out property <[ModbusQueryItem]> active-query-items;
    in-out property <[ModbusQueryLayoutRow]> modbus-query-layout-rows;

    in-out property <string> firmware-current-version;
    in-out property <string> firmware-status-text;
    in-out property <string> firmware-file-name;
    in-out property <string> firmware-file-size;
    in-out property <string> firmware-md5;
    in-out property <string> firmware-type-text;
    in-out property <string> firmware-image-version;
    in-out property <string> firmware-layout-text;
    in-out property <string> firmware-parse-source;
    in-out property <string> firmware-dev-model;
    in-out property <bool> firmware-has-file;
    in-out property <int> firmware-phase;
    in-out property <int> firmware-progress;
    in-out property <int> firmware-pc-percent;
    in-out property <int> firmware-device-percent;
    in-out property <string> firmware-stage-text;
    in-out property <string> firmware-result-text;
    in-out property <string> firmware-fail-reason;
    in-out property <bool> firmware-can-start;
    in-out property <bool> firmware-can-stop;

    in-out property <int> current-page: 0;
    in-out property <int> dialog-kind: 0;
    in-out property <string> dialog-name: "";

    in-out property <bool> show-add-query-form: false;
    in-out property <string> query-form-name: "";
    in-out property <string> query-form-register: "";
    in-out property <int> query-form-value-type-index: 0;
    in-out property <string> query-form-register-count: "";
    in-out property <string> query-form-scale: "";

    in-out property <string> active-tab-slave-id: "0";
    in-out property <bool> has-selected-queries;
    in-out property <[bool]> query-selection-states;
    in-out property <[string]> dialog-tab-options;

    in-out property <int> renaming-tab-index: -1;
    in-out property <string> editing-tab-title: "";

    in-out property <[DeviceConfigGroup]> config-groups;
    in-out property <int> active-config-group: 0;
    in-out property <[DeviceConfigItem]> active-config-items;
    in-out property <[BuiltinConfigItem]> builtin-config-items;
    in-out property <string> active-group-slave-id: "0";
    in-out property <int> renaming-config-group-index: -1;
    in-out property <string> editing-group-title: "";
    in-out property <bool> show-add-config-form: false;
    in-out property <string> config-form-name: "";
    in-out property <string> config-form-register: "";
    in-out property <int> config-form-widget-index: 1;
    in-out property <int> config-form-value-type-index: 0;
    in-out property <string> config-form-register-count: "1";

    callback navigate(int);
    callback ble-action-clicked();
    callback select-scan-device(string);
    callback connect-selected-clicked();
    callback toggle-favorite-clicked(string);
    callback ble-scan-filters-changed();
    callback ac-output-toggle();
    callback dc-output-toggle();
    callback add-modbus-tab-request();
    callback remove-modbus-tab(int);
    callback switch-modbus-tab(int);
    callback start-rename-modbus-tab(int);
    callback commit-rename-modbus-tab();
    callback cancel-rename-modbus-tab();
    callback commit-tab-slave-id();
    callback show-add-query-panel(int);
    callback confirm-add-query();
    callback cancel-add-query();
    callback remove-modbus-query(int, int);
    callback select-modbus-query(int, bool);
    callback copy-selected-modbus-query();
    callback dialog-pick-copy-tab(int);
    callback modbus-query-layout-width-changed(length);
    callback firmware-pick-file();
    callback firmware-clear-file();
    callback firmware-start();
    callback firmware-stop();
    callback dialog-confirm();
    callback dialog-cancel();
    callback set-theme-mode(int);
    callback toggle-theme-quick();

    callback add-device-config-group-request();
    callback remove-device-config-group(int);
    callback switch-device-config-group(int);
    callback start-rename-device-config-group(int);
    callback commit-rename-device-config-group();
    callback commit-device-config-group-slave-id();
    callback show-add-device-config-panel();
    callback confirm-add-device-config();
    callback cancel-add-device-config();
    callback device-config-value-edited(int, string);
    callback write-device-config-item(int);
    callback remove-device-config-item(int);
    callback builtin-config-value-edited(int, string);
    callback write-builtin-config-item(int);

    title: "BLE Modbus 工具";
    preferred-width: 960px;
    preferred-height: 640px;
    background: Theme.bg-window;

    init => {
        Theme.sync-palette();
    }

    VerticalBox {
        padding: 0px;
        spacing: 0px;

        BleStatusBar {
            connected: root.device-connected;
            scanning: root.scanning;
            connecting: root.ble-connecting;
            status-text: root.ble-status-text;
            device-name: root.ble-device-name;
            rssi-text: root.ble-rssi-text;
            action-text: root.ble-action-text;
            action-clicked => {
                root.ble-action-clicked();
            }
        }

        Rectangle {
            vertical-stretch: 1;

            HorizontalBox {
                padding: 0px;
                spacing: 0px;

                Sidebar {
                    current-page: root.current-page;
                    device-connected: root.device-connected;
                    navigate(page) => {
                        root.navigate(page);
                    }
                    toggle-theme => {
                        root.toggle-theme-quick();
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.bg-window;

                    VerticalBox {
                        padding: 8px;
                        spacing: 8px;

                        if root.current-page == 0: DashboardPage {
                            device-connected: root.device-connected;
                            scanning: root.scanning;
                            ble-connecting: root.ble-connecting;
                            scan-devices: root.scan-devices;
                            favorite-devices: root.favorite-devices;
                            scan-device-total: root.scan-device-total;
                            scan-empty-message: root.scan-empty-message;
                            selected-scan-address <=> root.selected-scan-address;
                            scan-filter <=> root.ble-scan-filter;
                            scan-rssi-filter-enabled <=> root.ble-scan-rssi-filter-enabled;
                            scan-rssi-min <=> root.ble-scan-rssi-min;
                            dashboard-soc: root.dashboard-soc;
                            dashboard-ac-output-w: root.dashboard-ac-output-w;
                            dashboard-dc-output-w: root.dashboard-dc-output-w;
                            dashboard-pv-input-w: root.dashboard-pv-input-w;
                            dashboard-ac-input-w: root.dashboard-ac-input-w;
                            dashboard-data-valid: root.dashboard-data-valid;
                            ac-output-on: root.ac-output-on;
                            dc-output-on: root.dc-output-on;
                            output-control-busy: root.output-control-busy;
                            select-scan-device(address) => {
                                root.select-scan-device(address);
                            }
                            connect-selected-clicked => {
                                root.connect-selected-clicked();
                            }
                            toggle-favorite-clicked(address) => {
                                root.toggle-favorite-clicked(address);
                            }
                            scan-filters-changed => {
                                root.ble-scan-filters-changed();
                            }
                            ac-output-toggle => {
                                root.ac-output-toggle();
                            }
                            dc-output-toggle => {
                                root.dc-output-toggle();
                            }
                        }

                        if root.current-page == 1: ModbusPage {
                            device-connected: root.device-connected;
                            modbus-tabs: root.modbus-tabs;
                            active-modbus-tab: root.active-modbus-tab;
                            active-query-items: root.active-query-items;
                            query-layout-rows: root.modbus-query-layout-rows;
                            show-add-query-form: root.show-add-query-form;
                            query-form-name <=> root.query-form-name;
                            query-form-register <=> root.query-form-register;
                            query-form-value-type-index <=> root.query-form-value-type-index;
                            query-form-register-count <=> root.query-form-register-count;
                            query-form-scale <=> root.query-form-scale;
                            active-tab-slave-id <=> root.active-tab-slave-id;
                            has-selected-queries: root.has-selected-queries;
                            query-selection-states: root.query-selection-states;
                            renaming-tab-index: root.renaming-tab-index;
                            editing-tab-title <=> root.editing-tab-title;
                            add-tab-request => {
                                root.add-modbus-tab-request();
                            }
                            remove-tab(index) => {
                                root.remove-modbus-tab(index);
                            }
                            switch-tab(index) => {
                                root.switch-modbus-tab(index);
                            }
                            start-rename-tab(index) => {
                                root.start-rename-modbus-tab(index);
                            }
                            commit-rename-tab => {
                                root.commit-rename-modbus-tab();
                            }
                            commit-tab-slave-id => {
                                root.commit-tab-slave-id();
                            }
                            show-add-query-panel(index) => {
                                root.show-add-query-panel(index);
                            }
                            confirm-add-query => {
                                root.confirm-add-query();
                            }
                            cancel-add-query => {
                                root.cancel-add-query();
                            }
                            remove-query(tab, item) => {
                                root.remove-modbus-query(tab, item);
                            }
                            select-query(index, ctrl) => {
                                root.select-modbus-query(index, ctrl);
                            }
                            copy-selected-query => {
                                root.copy-selected-modbus-query();
                            }
                            layout-width-changed(width) => {
                                root.modbus-query-layout-width-changed(width);
                            }
                        }

                        if root.current-page == 2: SettingsPage {
                            set-theme-mode(mode) => {
                                root.set-theme-mode(mode);
                            }
                        }

                        if root.current-page == 3: FirmwarePage {
                            device-connected: root.device-connected;
                            device-name: root.ble-device-name;
                            firmware-status-text: root.firmware-status-text;
                            firmware-file-name: root.firmware-file-name;
                            firmware-file-size: root.firmware-file-size;
                            firmware-md5: root.firmware-md5;
                            firmware-type-text: root.firmware-type-text;
                            firmware-image-version: root.firmware-image-version;
                            firmware-dev-model: root.firmware-dev-model;
                            firmware-has-file: root.firmware-has-file;
                            firmware-phase: root.firmware-phase;
                            firmware-progress: root.firmware-progress;
                            firmware-pc-percent: root.firmware-pc-percent;
                            firmware-device-percent: root.firmware-device-percent;
                            firmware-stage-text: root.firmware-stage-text;
                            firmware-result-text: root.firmware-result-text;
                            firmware-fail-reason: root.firmware-fail-reason;
                            firmware-can-start: root.firmware-can-start;
                            firmware-can-stop: root.firmware-can-stop;
                            pick-file => { root.firmware-pick-file(); }
                            clear-file => { root.firmware-clear-file(); }
                            start-upgrade => { root.firmware-start(); }
                            stop-upgrade => { root.firmware-stop(); }
                        }

                        if root.current-page == 4: DeviceConfigPage {
                            device-connected: root.device-connected;
                            config-groups: root.config-groups;
                            active-config-group: root.active-config-group;
                            active-config-items: root.active-config-items;
                            builtin-config-items: root.builtin-config-items;
                            active-group-slave-id <=> root.active-group-slave-id;
                            renaming-group-index: root.renaming-config-group-index;
                            editing-group-title <=> root.editing-group-title;
                            show-add-config-form: root.show-add-config-form;
                            config-form-name <=> root.config-form-name;
                            config-form-register <=> root.config-form-register;
                            config-form-widget-index <=> root.config-form-widget-index;
                            config-form-value-type-index <=> root.config-form-value-type-index;
                            config-form-register-count <=> root.config-form-register-count;
                            add-group-request => { root.add-device-config-group-request(); }
                            remove-group(index) => { root.remove-device-config-group(index); }
                            switch-group(index) => { root.switch-device-config-group(index); }
                            start-rename-group(index) => { root.start-rename-device-config-group(index); }
                            commit-rename-group => { root.commit-rename-device-config-group(); }
                            commit-group-slave-id => { root.commit-device-config-group-slave-id(); }
                            show-add-config-panel => { root.show-add-device-config-panel(); }
                            confirm-add-config => { root.confirm-add-device-config(); }
                            cancel-add-config => { root.cancel-add-device-config(); }
                            config-value-edited(index, value) => { root.device-config-value-edited(index, value); }
                            write-config-item(index) => { root.write-device-config-item(index); }
                            remove-config-item(index) => { root.remove-device-config-item(index); }
                            builtin-value-edited(index, value) => { root.builtin-config-value-edited(index, value); }
                            write-builtin-item(index) => { root.write-builtin-config-item(index); }
                        }
                    }
                }
            }

            NewTabDialog {
                dialog-kind: root.dialog-kind;
                dialog-name <=> root.dialog-name;
                dialog-tab-options: root.dialog-tab-options;
                confirm => {
                    root.dialog-confirm();
                }
                cancel => {
                    root.dialog-cancel();
                }
                pick-tab(index) => {
                    root.dialog-pick-copy-tab(index);
                }
            }
        }
    }
}
