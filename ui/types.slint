export enum QueryCardStatus {
    pending,
    ok,
    missed,
    stalled,
    bad-address,
    parse-error,
}

export enum FirmwarePhase {
    idle,
    ready,
    running,
    success,
    failed,
}

export enum RegValueType {
    integer,
    float,
    text,
}

export global RegValueLabel {
    public pure function text(kind: RegValueType) -> string {
        if kind == RegValueType.float {
            "float"
        } else if kind == RegValueType.text {
            "string"
        } else {
            "integer"
        }
    }
}

/// 灵活配置项的控件。
export enum ConfigWidget {
    switch,
    text,
    number,
}

/// 常用设置的控件。`choice` 是枚举下拉，和灵活项的文本框不是同一种。
export enum BuiltinControl {
    switch,
    choice,
    number,
}

/// 侧栏页面。旧的整数里空过 2（已删除的设置页），改成枚举后不再占位。
export enum AppPage {
    dashboard,
    modbus,
    firmware,
    device-config,
    external,
}

export enum DialogKind {
    none,
    new-tab,
    copy-query,
}

export enum WifiPickerKind {
    closed,
    scan,
    history,
}

export struct ModbusQueryItem {
    name: string,
    register: string,
    value-type: RegValueType,
    /// 连续保持寄存器个数（默认 1）
    register-count: int,
    /// 整数显示倍数，实际值 = 原始值 / scale（默认 1）
    scale: int,
    status: QueryCardStatus,
    result: string,
    result-display: string,
    /// 整数调试 hex（如 `0x10`）；非整数或无效读回为空
    result-hex: string,
    /// 一行放不下时 hex 改到数字下方（如 SN）
    result-hex-below: bool,
    result-font-size: int,
}

export struct ModbusQueryLayoutRow {
    indices: [int],
}

export struct ModbusTab {
    title: string,
    slave-id: string,
    items: [ModbusQueryItem],
}

export struct DashboardMetric {
    label: string,
    value: string,
    unit: string,
    hint: string,
    accent-color: color,
}

export struct BleScanDevice {
    name: string,
    address: string,
    rssi: string,
}

export struct BleFavoriteDevice {
    name: string,
    address: string,
    /// 未扫描到时为空或提示文案
    rssi: string,
    /// 当前扫描中已发现
    seen: bool,
    /// 广播标记为已被其它主机连接
    occupied: bool,
    /// 绿点状态：附近已发现且可连接
    selectable: bool,
}

/// 设备配置项（Modbus 寄存器读写；无倍数，控件决定展示方式）
/// 读回（result*）与写入（write-value）分离，轮询只更新读回，不覆盖编辑框。
/// `status` 是给用户看的说明，可以是写入失败的原文；`awaiting` 才表示还没有读过。
export struct DeviceConfigItem {
    name: string,
    register: string,
    value-type: RegValueType,
    register-count: int,
    widget-kind: ConfigWidget,
    /// 轮询读回原始/解析结果（与查询页 result 同角色）
    result: string,
    result-display: string,
    /// 整数调试 hex（如 `0x10`）；非整数或无效读回为空
    result-hex: string,
    result-font-size: int,
    /// 待写入值（开关用 "0"/"1"）；编辑只改这里
    write-value: string,
    status: string,
    awaiting: bool,
    /// 本地已改、尚未写入设备
    dirty: bool,
}

export struct DeviceConfigGroup {
    title: string,
    slave-id: string,
    /// 固定「常用」组：不可删、不可改名、不可加灵活项
    builtin: bool,
    items: [DeviceConfigItem],
}

/// 常用设置项（代码映射；可含 bit 域）。读写分离同灵活项。
export struct BuiltinConfigItem {
    id: string,
    name: string,
    register: string,
    value-type: RegValueType,
    register-count: int,
    widget-kind: BuiltinControl,
    enum-labels: [string],
    enum-values: [string],
    enum-index: int,
    result-display: string,
    /// 整数调试 hex（如 `0x10`）；非整数或无效读回为空
    result-hex: string,
    write-value: string,
    status: string,
    awaiting: bool,
    dirty: bool,
    write-enabled: bool,
    disabled-hint: string,
}

/// 本机保存过的 WiFi（密码仅用于回填，列表里不展示）。
export struct WifiSavedNetwork {
    ssid: string,
    password: string,
}

/// 本机扫描到的附近 AP。
export struct WifiScanAp {
    ssid: string,
    signal: string,
    band: string,
}

/// 21000 段上报的组网节点（本机或配件）。
export struct SubDeviceInfo {
    role: string,
    type-name: string,
    sn: string,
    addr-text: string,
    status-text: string,
    online: bool,
    alarm: bool,
}
