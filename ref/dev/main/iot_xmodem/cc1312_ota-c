/**
  * @brief      升级子设备数获取
  * @param[in]  void  
  * @param[out] None
  * @return     void
  */
uint8_t cc1312_NS_ota_num_get(void)
{
    uint8_t i = 0;
    uint8_t is_ota_dev_num = 0;
    
    for (i = 0; i < NET_SUB1G_MAX_POINT; i++)
    {
        if ((NET_POINT_ONLINE == reals.net_point_base_Info[i].net_point_online)
            &&(RF_OTA_STA_DOING == reals.net_point_ota_Info[i].is_ota))//判断该设备信息是否所需
        {            
            is_ota_dev_num++;
        }
    }
    
    return is_ota_dev_num;
}

/**
 * @brief 从文件系统中获取升级数据
 *
 * @param data 保存数据的指针
 * @param size 文件大小
 * @return 成功返回0,否则返回-1
 */
static int cc1312_get_ota_data(uint8_t *data, int size)
{
	/* 只读格式打开文件 */
	FILE *fp = fopen(bin_file_name, "rb");
	if(fp == NULL) return -1;

	/* 读数据到缓存 */
	if(fread(data, 1, size, fp) != size) {
		goto __error;
	}

	fclose(fp);

	// for(int i = 0; i < 64; i++) {
	// 	ESP_LOG_BUFFER_HEXDUMP(TAG, data+(i*16), 16, ESP_LOG_WARN);
	// 	vTaskDelay(20);
	// }

	return 0;

__error:
	fclose(fp);
	return -1;
}

/**
 * @brief cc1312升级任务
 * - 1、通过modbus协议向lcd发起升级请求
 * - 2、设置xmodem服务接口
 * - 3、启动xmodem服务开始xmodem升级
 * - 4、升级退出时释放申请的内存资源同时删除本任务
 * - 升级结束后meta协议的升级状态仍然会保持,直到下次升级开始时清除
 *
 * @param pvParameters 任务参数
 * @return 无
 */
static void cc1312_ota_thread(void * pvParameters)
{
	vTaskDelay(pdMS_TO_TICKS(1000));
	esp_log_level_set("[MCU_CORE]", ESP_LOG_DEBUG);
	uart_recv_sem = xSemaphoreCreateBinary();
	assert(uart_recv_sem != NULL);

    //esp_log_level_set("[BLE_ENCRYPT]",ESP_LOG_NONE );
    esp_log_level_set("[MODBUS]",ESP_LOG_NONE );
    esp_log_level_set("[md_protocol]",ESP_LOG_NONE );//
    esp_log_level_set("[modbus_slave_data]",ESP_LOG_NONE );//

	ESP_LOGW(TAG, "cc1312 ota thread running...");
	uint32_t ota_start_time = xTaskGetTickCount() * portTICK_PERIOD_MS;
//	ESP_LOGW(TAG, "close wifi...");
//	iot_wifi_close(WIFI_MODE_ALL); // 升级时，关掉WiFi保证升级的稳定性和速度
	vTaskDelay(pdMS_TO_TICKS(2000));

	/* 通过modbus协议发起升级请求 */
	if (cc1312_ota_initiate() != 0)
	{
		ESP_LOGE(TAG, "cc1312_ota_initiate failed");
        
        cc1312_ota_state.is_ota = RF_OTA_STA_CPLT;                  // 升级结束状态设置为已完成
		cc1312_ota_state.err_code = ERR_FILE_INVALID;
        MicroInv[0].mod_reg00700_OTA.ota_group[0].isOta = RF_OTA_STA_IDLE;
        MicroInv[0].mod_reg00700_OTA.ota_group[0].errCode = ERR_FILE_INVALID;
        set_ota_pct_info(NULL,NULL,NULL,NULL,2,0,ERR_FILE_INVALID);
		goto __exit;
	}

	/* 获取升级数据,数据可能存在文件中,也可能存在内存中 */
	bin_data_size = cc1312_ota_set.file_size * 1024;
	if (bin_ota_data == NULL)	// ota_data为空则升级数据存在文件中,否则升级数据存在内存中
	{
		// #define F_OK	0	//判断文件是否存在
		// #define X_OK	1	//判断对文件是可执行权限
		// #define W_OK	2	//判断对文件是否有写权限
		// #define R_OK	4	//判断对文件是否有读权限
		if (access(bin_file_name, F_OK) < 0)
		{
			ESP_LOGE(TAG, "ota bin file is not accessible, file name: %s", bin_file_name);

            cc1312_ota_state.is_ota = RF_OTA_STA_CPLT;                  // 升级结束状态设置为已完成
    		cc1312_ota_state.err_code = ERR_FLASH_READ_FIALED;
            MicroInv[0].mod_reg00700_OTA.ota_group[0].isOta = RF_OTA_STA_IDLE;
            MicroInv[0].mod_reg00700_OTA.ota_group[0].errCode = ERR_FLASH_READ_FIALED;
            set_ota_pct_info(NULL,NULL,NULL,NULL,2,0,ERR_FLASH_READ_FIALED);
			goto __exit;
		}

		bin_ota_data = heap_caps_malloc(bin_data_size, MALLOC_CAP_SPIRAM);
