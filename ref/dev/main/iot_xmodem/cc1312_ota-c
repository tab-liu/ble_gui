/*------------------------------------------------------------------------------
 Function: cc1312_xmd_send
 -----------------------------------------------------------------------------*/
/**
  * @brief      计算crc，发送
  * @param[in]  uint8_t * write_status  
  * @param[out] None
  * @return     static void- 用于指示本次发送是否成功,0-发送失败,1-发送成功
  */
static void cc1312_xmd_send(uint8_t * write_status)
{
    //lxy 计算crc，发送
    UART_STRUCT *uart_structx = &reals.struct_uart1;
    uint8_t j = 0;
    
    memset(uart_structx->Txbuffer, 0, UART1_TX_BUF_SIZE);
    uart_structx->TxBytesNum = 0;
    
    uart_structx->Txbuffer[uart_structx->TxBytesNum++] = 0;//reserved
    uart_structx->Txbuffer[uart_structx->TxBytesNum++] = MESH_VERSION_TYPE_SUB1GHZ;
	 for (j = 0; j <= 7; j++)//源 MAC*8
	 {
		 uart_structx->Txbuffer[uart_structx->TxBytesNum++] = reals.local_mac_union.MAC[j];//MAC
	 }  
	 for (j = 0; j <= 7; j++)//目标 MAC*8
	 {
		 //uart_structx->Txbuffer[uart_structx->TxBytesNum++] = reals.mac_union.MAC[j];//MAC
		 uart_structx->Txbuffer[uart_structx->TxBytesNum++] = reals.local_mac_union.MAC[j];//MAC
	 }   	 	 
    uart_structx->Txbuffer[uart_structx->TxBytesNum++] = MESH_FRAME_TYPE_XMODEM;//报文类型
    
    memcpy(&uart_structx->Txbuffer[uart_structx->TxBytesNum], xm_tx_buff, xm_tx_len);
    uart_structx->TxBytesNum += xm_tx_len;

    uint16_t crc16 = crc16_modbus_calc(uart_structx->Txbuffer, uart_structx->TxBytesNum);
    uart_structx->Txbuffer[uart_structx->TxBytesNum++] = (uint8_t)crc16;
    uart_structx->Txbuffer[uart_structx->TxBytesNum++] = (uint8_t)(crc16 >> 8);
    
    //ESP_LOGW(TAG, "");
    ESP_LOGW(TAG, "cc1312_xmd_send, len:%u", uart_structx->TxBytesNum);
    //ESP_LOG_BUFFER_HEX_LEVEL(TAG,uart_structx->Txbuffer, uart_structx->TxBytesNum,ESP_LOG_WARN);
    
	int ret = uart_write_bytes(uart_num, uart_structx->Txbuffer, uart_structx->TxBytesNum);
	if (ret < 0) *write_status = 0;
	else *write_status = 1;

    memset(xm_tx_buff, 0, UART_TX_BUF_SIZE);
    xm_tx_len = 0;
}

/**
 * @brief xmodem读取数据接口
 *
 * @param requested_size 请求的数据大小
 * @param buffer 数据缓存
 * @param returned_size 实际返回的数据大小
 * @return 无
 */
static void cc1312_xmd_read(const uint32_t requested_size, uint8_t * buffer, uint32_t * returned_size)
{
    #if 1

    if (recv_len < requested_size)
	{
        ESP_LOGE(TAG, "recv_len < requested_size");
		*returned_size = 0;
		return;
	}

	*returned_size = recv_len;
	memcpy(buffer, recv_buff, requested_size);
	recv_len = 0;
    
    ESP_LOGW(TAG, "");
    ESP_LOGW(TAG, "cc1312_xmd_read, requested_size:%lu, returned_size:%lu, data:", requested_size, *returned_size);
    ESP_LOG_BUFFER_HEX(TAG, recv_buff, *returned_size);
    #elif
    
    int frame = Sub_Net_Frame_Modbus_Format_Check(recv_buff, recv_len);
    if (frame == MESH_FRAME_TYPE_XMODEM_RTN)
    {
    	if ((recv_len - 21) < requested_size)
    	{
    		*returned_size = 0;
    		return;
    	}

    	*returned_size = recv_len-21;
    	memcpy(buffer, &recv_buff[MESH_FRAME_ADDR_MODBUS_HEAD], requested_size);
    	recv_len = 0;
    }
    else
    {
        *returned_size = 0;
		return;
    }
    #endif
}

