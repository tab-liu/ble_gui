 * @brief 获取cc1312模块升级状态
 *
 * @return 0-未升级, 1-正在升级
 */
int cc1312_ota_is_doing(void)
{
	return ota_flag;
}

/**
 * @brief cc1312升级模块数据接收接口
 *
 * @param data 接收到的数据指针
 * @param len 数据长度
 *
 * @return 无
 */
void cc1312_ota_recv(uint8_t *data, int len)
{
	if (!ota_flag) return;

    MAC_UNION Source_Mac_union;
    MAC_UNION Target_Mac_union;
    uint8_t i = 0;
    uint8_t recv_flag = 0; //汇总上报标志 0：ack   1：nack   2：等待
    uint8_t is_ota_dev_num = 0;
    
    memcpy(&Source_Mac_union.MAC, &data[MESH_FRAME_ADDR_MAC_SOURCE], 8);
    memcpy(&Target_Mac_union.MAC, &data[MESH_FRAME_ADDR_MAC_TARGET], 8);
    
    //边界路由升级/回复
    if((Source_Mac_union.MAC_64 == Target_Mac_union.MAC_64)
        ||(data[MESH_FRAME_ADDR_TYPE] == MESH_FRAME_TYPE_WRITE_RTN))
    {
    	memcpy(recv_buff, &data[MESH_FRAME_ADDR_MODBUS_HEAD], len-21);
    	recv_len = len-21;
        
    	if (uart_recv_sem) 
        {
		    xSemaphoreGive(uart_recv_sem);
	    }
    }
    else
    {
        for (i = 0; i < NET_SUB1G_MAX_POINT; i++)
        {
            if (Source_Mac_union.MAC_64 == reals.net_point_base_Info[i].mac_union.MAC_64)
            {
                reals.net_point_ota_Info[i].packed_rtn = data[MESH_FRAME_ADDR_MODBUS_HEAD];//存储子设备回复信息
                break;
            }
        }
        
        for (i = 0; i < NET_SUB1G_MAX_POINT; i++)
        {
            if ((NET_POINT_ONLINE == reals.net_point_base_Info[i].net_point_online)
                &&(RF_OTA_STA_DOING == reals.net_point_ota_Info[i].is_ota))//判断该设备信息是否所需
            {
                if(reals.net_point_ota_Info[i].packed_rtn == NACK)//高优先级
                {
                    recv_flag = 1;//有设备回复nack
                }
                else if((reals.net_point_ota_Info[i].packed_rtn != ACK)&&(recv_flag == 0))
                {
                    recv_flag = 2;//有设备仍未回复或非法回复
                }
                
                is_ota_dev_num++;
            }
        }
        
        ESP_LOGI(TAG, "is_ota_dev_num: %d",is_ota_dev_num);
        
        if(is_ota_dev_num == 0)//无设备升级
        {
            recv_flag = 2;
        }
        
        switch (recv_flag)
        {
            case 0:
                recv_buff[0] = ACK;
    	        recv_len = 1;
                break;
                
            case 1:
                recv_buff[0] = NACK;
    	        recv_len = 1;
                break;         
                
            default:
                return;
        }
        
        if (uart_recv_sem) 
        {
		    xSemaphoreGive(uart_recv_sem);
	    }
    }   
}

