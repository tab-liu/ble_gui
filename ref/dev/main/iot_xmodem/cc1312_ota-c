 Function: cc1312_NS_ota_state_init
 -----------------------------------------------------------------------------*/
/**
  * @brief      子设备升级状态初始化
  * @param[in]  void       
  * @param[out] None
  * @return     void
  */
uint8_t cc1312_NS_ota_state_init(void)
{
    uint8_t i = 0;
    uint8_t j = 0;
    uint32_t old_version = 0xFFFFFFFF;
    uint32_t new_version = 0;
    uint8_t is_ota_dev_num = 0;

    ESP_LOGI(TAG, "[cc1312_NS_ota_state_init] cc1312_ota_set.file_type: %u",cc1312_ota_set.file_type);
    
    for (i = 0; i < NET_SUB1G_MAX_POINT; i++)
    {
        reals.net_point_ota_Info[i].write_block_retries = 0;
        reals.net_point_ota_Info[i].packed_rtn = 0;
        reals.net_point_ota_Info[i].is_ota = RF_OTA_STA_IDLE;
        
        if ((NET_POINT_ONLINE == reals.net_point_base_Info[i].net_point_online)
            &&(cc1312_ota_set.start_flag == 3))//子设备升级
        {
            for ( j = 0 ; j < 6 ; j++ )
            {
                //ESP_LOGW(TAG, "[cc1312_NS_ota_state_init] MicroInv[%d].mod_reg01100_Inv_base.soft[%d].type: %u",i+1,j,MicroInv[i+1].mod_reg01100_Inv_base.soft[j].type);
                if (cc1312_ota_set.file_type == MicroInv[i+1].mod_reg01100_Inv_base.soft[j].type)
                {
                    old_version = MicroInv[i+1].mod_reg01100_Inv_base.soft[j].version;
                    break;
                }
                //debug
                else if (cc1312_ota_set.file_type == RF)
                {
                    old_version = MicroInv[i+1].mod_reg11000_IOT_info.software_ver;
                    break;
                }
            }
            
            new_version = (uint32_t)(cc1312_ota_set.ver_high << 16)|(cc1312_ota_set.ver_low);
            ESP_LOGW(TAG, "[cc1312_NS_ota_state_init] old_version: %lu  new_version:%lu",old_version,new_version);

            if (old_version < new_version)//判断版本号，是否需要升级
            {
                reals.net_point_ota_Info[i].is_ota = RF_OTA_STA_DOING;
                is_ota_dev_num++;
            }
        }
    }
    
    ESP_LOGI(TAG, "[cc1312_NS_ota_state_init] is_ota_dev_num: %d",is_ota_dev_num);

    if (is_ota_dev_num)
    {
        return 0;
    }
    return 1;
}

/*------------------------------------------------------------------------------
 Function: cc1312_NS_ota_state_update
 -----------------------------------------------------------------------------*/
/**
  * @brief      更新子设备升级状态
  * @param[in]  void        
  * @param[out] None
  * @return     void
  */
void cc1312_NS_ota_state_update(void)
{
    uint8_t i = 0;
    
    for (i = 0; i < NET_SUB1G_MAX_POINT; i++)
    {
        if (RF_OTA_STA_DOING == reals.net_point_ota_Info[i].is_ota)//判断该设备信息是否所需
        {
            if((reals.net_point_ota_Info[i].packed_rtn != ACK)
                &&(reals.net_point_ota_Info[i].packed_rtn != C))
            {
                reals.net_point_ota_Info[i].write_block_retries++;//有设备仍未回复或非法回复，标记
            }
            else
            {
                reals.net_point_ota_Info[i].write_block_retries = 0;
            }
            
            if(reals.net_point_ota_Info[i].write_block_retries > 4)
            {
                reals.net_point_ota_Info[i].is_ota = RF_OTA_STA_IDLE;//有设备升级出错，不再处理
                MicroInv[0].mod_reg00700_OTA.ota_group[i].isOta = RF_OTA_STA_IDLE;
                
                if((reals.net_point_ota_Info[i].packed_rtn != NACK)
                    &&(reals.net_point_ota_Info[i].packed_rtn != CAN))
                {
                    MicroInv[0].mod_reg00700_OTA.ota_group[i].errCode = ERR_DEV_NO_RSP;
                }
                else
                {
                    MicroInv[0].mod_reg00700_OTA.ota_group[i].errCode = ERR_DEV_ABORT;
                }
            }

            reals.net_point_ota_Info[i].packed_rtn = 0;
        }
    }
}

