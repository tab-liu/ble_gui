/**
 * @brief 创建cc1312升级任务
 *
 * @return 0 if successful, otherwise -1
 */
static int cc1312_ota_task_create(void)
{
	if (xTaskCreatePinnedToCore(cc1312_ota_thread, "cc1312_ota_thread",  1024 * 4, NULL, 4, NULL, 1) != pdPASS)
	{
		ESP_LOGE(TAG, "cc1312 ota thread create failed");
		return -1;
	}

	return 0;
}

/**
 * @brief cc1312升级开始接口
 * - 当外部模块调用该接口时cc1312升级内核开始运行
 *
 * @param ota_set 升级设置参数
 * @param bin_path 固件路劲
 * @param bin_data 固件数据指针
 * - bin_path与bin_data可二选一,如果同时存在则取bin_data作为升级数据源
 *
 * @return 成功返回0否则返回-1
 */
int cc1312_ota_start(ota_set_t *ota_set, char *bin_path, uint8_t *bin_data)
{
	if (ota_flag) return -1;
	if ((ota_set == NULL) || ((bin_path == NULL) && (bin_data == NULL)))
	{
		cc1312_ota_state.err_code = ERR_FILE_INVALID;
		return -1;
	}

	memcpy(&cc1312_ota_set, ota_set, sizeof(ota_set_t));
      
    ESP_LOGW(TAG, "lxy sub1g debug : Group[%d : %d] type=%u, version=%lu, size=%u",
    cc1312_ota_set.group.dev_type, cc1312_ota_set.group.dev_id,
    cc1312_ota_set.file_type,
    ((uint32_t)(cc1312_ota_set.ver_high << 16) | cc1312_ota_set.ver_low),
    cc1312_ota_set.file_size);
    
//	if (bin_path) {
//		strncpy(bin_file_name, bin_path, sizeof(bin_file_name));
//	}
//	else {
//		bin_ota_data = bin_data;
//	}

	memset(&cc1312_ota_state, 0x00, sizeof(ota_state_t));
	cc1312_ota_state.group = cc1312_ota_set.group;
	cc1312_ota_state.is_ota = RF_OTA_STA_DOING;			// 正在升级
	cc1312_ota_state.level = 1;							// iot传递给设备
	cc1312_ota_state.target_pos = cc1312_ota_set.file_type;	// ota的目标位置
	cc1312_ota_state.now_pos = cc1312_ota_set.file_type;		// 当前位置

	if (cc1312_ota_task_create() != 0)
	{
        cc1312_ota_state.is_ota = RF_OTA_STA_CPLT;                  // 升级结束状态设置为已完成
		cc1312_ota_state.err_code = ERR_OUT_OF_MEMORY;
        MicroInv[0].mod_reg00700_OTA.ota_group[0].isOta = RF_OTA_STA_IDLE;
        MicroInv[0].mod_reg00700_OTA.ota_group[0].errCode = ERR_OUT_OF_MEMORY;
        set_ota_pct_info(NULL,NULL,NULL,NULL,2,0,ERR_OUT_OF_MEMORY);
		return -1;
	}

	ota_flag = 1;
	ESP_LOGI(TAG, "cc1312 ota start");
	return 0;
}

