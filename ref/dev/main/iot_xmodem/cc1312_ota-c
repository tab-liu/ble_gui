/**
 * @brief cc1312发起升级
 * - 该函数将会向cc1312发起升级,通过modbus的700寄存器组写入数据实现
 * - lcd正确响应该包指令后后续开始进入xmodem升级流程
 * - 发送指令后等待1s的响应时间,如果未响应或响应错误则重复发送指令,最多发送5次
 *
 * @return 成功返回0,否则返回-1
 */
static int cc1312_ota_initiate(void)
{
	#define MD_WRITE			0x10			// modbus写多寄存器功能码
	#define MD_OTA_REG_ADDR		((uint16_t)700)	// OTA寄存器起始地址

	uint8_t i = 0;
	uint8_t j = 0;
	uint8_t buff[100];
	uint16_t reg_nums = sizeof(ota_set_t) / sizeof(short);
    
    if (cc1312_NS_ota_state_init())
    {
        return -1;
    }

    
    #if 1
    
    buff[i++] = 0;//reserved
    buff[i++] = MESH_VERSION_TYPE_SUB1GHZ;//
	 for (j = 0; j <= 7; j++)//源 MAC*8
	 {
		 buff[i++] = reals.local_mac_union.MAC[j];//MAC
	 }  
	 for (j = 0; j <= 7; j++)//目标 MAC*8
	 {
		 //buff[i++] = reals.mac_union.MAC[j];//MAC
		 buff[i++] = reals.local_mac_union.MAC[j];//MAC
	 }   	 
    buff[i++] = MESH_FRAME_TYPE_WRITE;//报文类型
    
	//buff[i++] = LCD_MD_ADDR;
    buff[i++] = SUB1G_MD_ADDR;
	buff[i++] = MD_WRITE;
	buff[i++] = MD_OTA_REG_ADDR >> 8;
	buff[i++] = (uint8_t)MD_OTA_REG_ADDR;
	buff[i++] = reg_nums >> 8;
	buff[i++] = (uint8_t)reg_nums;
	buff[i++] = (uint8_t)(reg_nums * 2);

    //debug
//    if (cc1312_ota_set.file_type == RF)
//    {
//        cc1312_ota_set.file_type = 18;
//    }
	memcpy(&buff[i], &cc1312_ota_set, sizeof(cc1312_ota_set));
    //debug
//    if (cc1312_ota_set.file_type == 18)
//    {
//        cc1312_ota_set.file_type = RF;
//    } 
    
	uint16_t *pdata = (uint16_t*)&buff[i];
	for (int n = 0; n < reg_nums; n++) {							// 交换高低字节
		pdata[n] = (pdata[n] >> 8) | (pdata[n] << 8);
	}
	i += sizeof(cc1312_ota_set);
    
	uint16_t crc_modbus = crc16_modbus_calc(&buff[MESH_FRAME_ADDR_MODBUS_HEAD], i - MESH_FRAME_ADDR_MODBUS_HEAD);
    buff[i++] = crc_modbus;
    buff[i++] = crc_modbus >> 8;
	uint16_t crc_mesh = crc16_modbus_calc(buff, i);
    buff[i++] = crc_mesh;
    buff[i++] = crc_mesh >> 8;
    
    #else
    uint16_t regdata[(sizeof(ota_set_t)>>1)];
    memcpy(regdata, &cc1312_ota_set, sizeof(cc1312_ota_set));
    Mesh_Modbus_MasterTxCmd(MD_OTA_REG_ADDR,reg_nums,buff,SUB1G_MD_ADDR,MESH_FRAME_TYPE_WRITE,regdata);
    #endif

	/* 发送ota开始到cc1312,同时等待其正确的响应,每次等待超时3s钟,如果5次发送失败则退出升级 */
	int retry = 5;
	do {
		recv_len = 0;
		while(xSemaphoreTake(uart_recv_sem, 0) == pdTRUE);			// 清除信号量
		int ret = uart_write_bytes(uart_num, (const char*)buff, i);			// 发起OTA开始指令
		ESP_LOGW(TAG, "modbus send ota start, ret = %d, len = %d, data:", ret, i);
		ESP_LOG_BUFFER_HEX_LEVEL(TAG, buff, i, ESP_LOG_WARN);

		/* 等待cc1312响应 */
		uint32_t begin_time = xTaskGetTickCount() * portTICK_PERIOD_MS;
		while(1)
		{
			if (xSemaphoreTake(uart_recv_sem, pdMS_TO_TICKS(3000)) == pdTRUE) {
				uint32_t now_time = xTaskGetTickCount() * portTICK_PERIOD_MS;

				/* 检查CRC */
				uint16_t crc_old = ((uint16_t)recv_buff[recv_len-1] << 8) | recv_buff[recv_len-2];
				uint16_t crc_new = crc16_modbus_calc(recv_buff, (recv_len-2));
				if(crc_old != crc_new)
				{
					ESP_LOGE(TAG, "respond crc error, addr: %d, len :%d", recv_buff[0], recv_len);
					if ((now_time - begin_time) > 3000) {
						break;
					}
					else {
						continue;
					}
				}

				/* 检查数据格式 */
				if (memcmp(&buff[MESH_FRAME_ADDR_MODBUS_HEAD], recv_buff, 6) != 0)
				{
					ESP_LOGE(TAG, "respond data error, data:");
					ESP_LOG_BUFFER_HEX_LEVEL(TAG, recv_buff, 6, ESP_LOG_ERROR);
					if ((now_time - begin_time) > 3000) {
						break;
					}
					else {
						continue;
					}
				}

				/* 响应正确退出 */
				goto __exit;
			}
			else {
				break;
			}
		}

		ESP_LOGE(TAG, "timeout for waiting ota reponse, retries:%d", retry);
	} while(--retry);

__exit:
	recv_len = 0;
	if (retry <= 0) return -1;
	return 0;
}

