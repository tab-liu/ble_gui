import { Palette, AppButton, StatusChip } from "theme.slint";

export component DecodeWindow inherits Window {
    title: "安全码解密";
    preferred-width: 520px;
    preferred-height: 560px;
    min-width: 420px;
    min-height: 480px;
    background: Palette.canvas;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 13px;

    in-out property <string> cipher: "";
    in-out property <string> plain: "—";
    in-out property <string> status: "";

    private property <bool> ready: root.plain != "" && root.plain != "—";

    callback decrypt();

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 12px;
            alignment: start;

            VerticalLayout {
                spacing: 2px;
                alignment: start;
                horizontal-stretch: 1;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Rectangle {
                        width: 3px;
                        height: 14px;
                        border-radius: 2px;
                        background: Palette.accent;
                    }

                    Text {
                        text: "安全码解密";
                        font-size: 16px;
                        font-weight: 700;
                        color: Palette.ink;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: "粘贴封好的密文，解开后只显示安全码";
                    font-size: 12px;
                    color: Palette.muted;
                }
            }

            if root.status != "": StatusChip {
                text: root.status;
                ok: root.status == "已解密";
                bad: root.status == "密文无效" || root.status == "请先粘贴密文";
            }
        }

        Rectangle {
            vertical-stretch: 1;
            min-height: 140px;
            preferred-height: 180px;
            background: Palette.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.line;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: "密文";
                        font-size: 13px;
                        font-weight: 700;
                        color: Palette.ink;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    AppButton {
                        label: "解密";
                        primary: root.cipher != "";
                        active: root.cipher != "";
                        clicked => {
                            root.decrypt();
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    min-height: 120px;
                    preferred-height: 160px;
                    background: Palette.surface;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: cipher-input.has-focus ? Palette.accent : Palette.line;
                    clip: true;

                    cipher-input := TextInput {
                        x: 10px;
                        y: 8px;
                        width: parent.width - 20px;
                        height: parent.height - 16px;
                        min-height: 0px;
                        min-width: 0px;
                        text <=> root.cipher;
                        single-line: false;
                        wrap: word-wrap;
                        font-family: "Consolas";
                        font-size: 13px;
                        color: Palette.ink;
                        vertical-alignment: top;
                        selection-background-color: #c5e4ea;
                        selection-foreground-color: Palette.ink;
                    }

                    if root.cipher == "" && !cipher-input.has-focus: Text {
                        x: 12px;
                        y: 10px;
                        text: "在此粘贴安全码密文";
                        font-size: 13px;
                        color: Palette.faint;
                    }
                }
            }
        }

        Rectangle {
            background: Palette.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.line;
            height: 152px;

            VerticalLayout {
                padding: 14px;
                spacing: 8px;
                alignment: start;

                Text {
                    text: "安全码";
                    font-size: 13px;
                    font-weight: 700;
                    color: Palette.ink;
                }

                Rectangle {
                    height: 72px;
                    background: root.ready ? #f3fafb : Palette.inset;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: root.ready ? Palette.live-line : Palette.line;

                    TextInput {
                        x: 12px;
                        y: 8px;
                        width: parent.width - 24px;
                        height: parent.height - 16px;
                        text: root.ready ? root.plain : "—";
                        read-only: true;
                        single-line: true;
                        font-family: "Consolas";
                        font-size: root.ready ? 24px : 16px;
                        font-weight: root.ready ? 700 : 400;
                        letter-spacing: root.ready ? 1px : 0px;
                        color: root.ready ? Palette.ink : Palette.faint;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        selection-background-color: #c5e4ea;
                        selection-foreground-color: Palette.ink;
                    }
                }

                Text {
                    text: root.ready ? "可选中复制" : "解密成功后显示在这里";
                    font-size: 12px;
                    color: Palette.faint;
                    horizontal-alignment: center;
                }
            }
        }
    }
}
